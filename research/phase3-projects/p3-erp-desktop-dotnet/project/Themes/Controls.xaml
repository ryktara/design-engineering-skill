<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:v="clr-namespace:ErpClient.Views">

    <!-- Spacing scale (4 px grid) and control metrics for the desktop density -->
    <sys:Double x:Key="Size.Row">32</sys:Double>
    <sys:Double x:Key="Size.Control">32</sys:Double>
    <Thickness x:Key="Space.Cell">8,0</Thickness>
    <Thickness x:Key="Space.Pane">16,8</Thickness>
    <!-- Page bands share one horizontal inset (16) and a 12 px vertical rhythm: title 12 above / 8 below, command bar 12 below, content 12 below -->
    <Thickness x:Key="Space.Band.Title">16,12,16,8</Thickness>
    <Thickness x:Key="Space.Band.Commands">16,0,16,12</Thickness>
    <Thickness x:Key="Space.Band.Content">16,0,16,12</Thickness>
    <Thickness x:Key="Space.Gap.Control">0,0,8,0</Thickness>
    <Thickness x:Key="Space.Gap.Group">16,0,0,0</Thickness>
    <Thickness x:Key="Space.Inset.Bar">16,0</Thickness>
    <Thickness x:Key="Space.Dialog.Inset">20</Thickness>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- Numeric role: right aligned, tabular lining figures, one precision per column -->
    <Style x:Key="Text.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Typography.NumeralStyle" Value="Lining"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource CellErrorTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}"/>
                <Setter Property="AutomationProperties.HelpText" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Cell validation: the cell (or the editor) paints a solid error tint BEHIND the text so the value keeps full contrast;
         the adorner adds only the 2 px error bar at the bottom. Message: tooltip, AutomationProperties.HelpText, and the status bar (F8 = next error). -->
    <ControlTemplate x:Key="CellErrorTemplate">
        <Grid>
            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource Brush.Feedback.Error}" Margin="-6,0,-6,-7" IsHitTestVisible="False"/>
            <AdornedElementPlaceholder/>
        </Grid>
    </ControlTemplate>
    <Style x:Key="Text.Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <!-- full value on hover/focus for trimmed cells (the error trigger below replaces it with the message) -->
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource CellErrorTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}"/>
                <Setter Property="AutomationProperties.HelpText" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Text.Cell.Mono" TargetType="TextBlock" BasedOn="{StaticResource Text.Cell}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Text.Cell.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Cell}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
    </Style>

    <!-- Editing element: no chrome of its own, the cell draws the focus ring -->
    <Style x:Key="Edit.Cell" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="AutomationProperties.HelpText" Value="Enter commits and moves down, Tab moves right, Escape cancels"/>
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource CellErrorTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Feedback.Error.Bg}"/>
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Edit.Cell.Numeric" TargetType="TextBox" BasedOn="{StaticResource Edit.Cell}">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- Numeric editor with an affix: the quantity editor shows the row's unit after the value, the money editor shows the
         order currency before it, so a value typed into the wrong column is labelled at the caret, not only in the header. -->
    <Style x:Key="Edit.Cell.Affix" TargetType="TextBox" BasedOn="{StaticResource Edit.Cell.Numeric}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="Prefix" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding (v:Affix.Prefix), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <TextBlock x:Name="Suffix" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding (v:Affix.Suffix), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Prefix" Property="Text" Value=""><Setter TargetName="Prefix" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger SourceName="Suffix" Property="Text" Value=""><Setter TargetName="Suffix" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Edit.Cell.Quantity" TargetType="TextBox" BasedOn="{StaticResource Edit.Cell.Affix}">
        <Setter Property="v:Affix.Suffix" Value="{Binding Unit}"/>
        <Setter Property="AutomationProperties.HelpText" Value="Quantity in the line's unit. Enter commits and moves down, Tab moves right, Escape cancels"/>
    </Style>
    <Style x:Key="Edit.Cell.Money" TargetType="TextBox" BasedOn="{StaticResource Edit.Cell.Affix}">
        <Setter Property="v:Affix.Prefix" Value="{Binding DataContext.Currency, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        <Setter Property="AutomationProperties.HelpText" Value="Amount in the order currency. Enter commits and moves down, Tab moves right, Escape cancels"/>
    </Style>
    <Style x:Key="Edit.Cell.Mono" TargetType="TextBox" BasedOn="{StaticResource Edit.Cell}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CharacterCasing" Value="Upper"/>
    </Style>
    <Style x:Key="Edit.Cell.Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsEditable" Value="False"/>
    </Style>
    <Style x:Key="Elem.Cell.Combo" TargetType="ComboBox" BasedOn="{StaticResource Edit.Cell.Combo}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- Column header: quiet strip, caption weight, right-aligned when the column is numeric.
         The header of the column that holds the current cell gets primary text and a 2 px bar (ActiveColumn.IsCurrent);
         group edges (ColumnGroup.Edge) draw a 1 px strong line so the money columns read as one block. -->
    <Style x:Key="Grid.Header" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Header}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="{StaticResource Size.Row}"/>
        <Setter Property="Padding" Value="{StaticResource Space.Cell}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="8" Height="5" Margin="6,0,0,0" VerticalAlignment="Center" Stretch="Fill" Fill="{DynamicResource Brush.Text.Secondary}" Data="M0,0 L1,0 0.5,1 Z" Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
                            </DockPanel>
                        </Border>
                        <Rectangle x:Name="GroupStart" Width="1" HorizontalAlignment="Left" Fill="{DynamicResource Brush.Border.Strong}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Rectangle x:Name="GroupEnd" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource Brush.Border.Strong}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Rectangle x:Name="ActiveBar" Height="2" VerticalAlignment="Bottom" Margin="0,0,1,0" Fill="{DynamicResource Brush.Focus.Ring}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Background="Transparent">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Column.(v:ActiveColumn.IsCurrent), RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Column.(v:ColumnGroup.Edge), RelativeSource={RelativeSource Self}}" Value="Start">
                            <Setter TargetName="GroupStart" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Column.(v:ColumnGroup.Edge), RelativeSource={RelativeSource Self}}" Value="End">
                            <Setter TargetName="GroupEnd" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleY="-1" CenterY="2.5"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Grid.Header.Numeric" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Grid.Header}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- Row header: line number + error marker (colour plus a glyph, never colour alone) -->
    <Style x:Key="Grid.RowHeader" TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Header}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRowHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="ErrorBar" Fill="{DynamicResource Brush.Feedback.Error}" Visibility="Collapsed"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Numeric}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="4,0,6,0"
                                       Text="{Binding DataContext.LineNo, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                            <TextBlock x:Name="ErrorGlyph" Grid.Column="2" Text="!" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Feedback.Error}" Visibility="Collapsed"
                                       ToolTip="{Binding DataContext.ErrorSummary, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.HasErrors, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter TargetName="ErrorBar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ErrorGlyph" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Selection.Bg}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row: hover and selection tint; text keeps its own colour (no white-on-blue) -->
    <Style x:Key="Grid.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Row}"/>
        <Setter Property="ValidationErrorTemplate" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface.Alt}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selection.Bg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Cell: constant 2 px border so the focus ring does not shift content; error shown as tint + bottom bar + tooltip -->
    <Style x:Key="Grid.Cell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Grid>
                        <!-- group edge lines sit under the ring so a focused cell still shows its full 2 px border -->
                        <Rectangle x:Name="GroupStart" Width="1" HorizontalAlignment="Left" Fill="{DynamicResource Brush.Border.Strong}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Rectangle x:Name="GroupEnd" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource Brush.Border.Strong}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Column.(v:ColumnGroup.Edge), RelativeSource={RelativeSource Self}}" Value="Start">
                            <Setter TargetName="GroupStart" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Column.(v:ColumnGroup.Edge), RelativeSource={RelativeSource Self}}" Value="End">
                            <Setter TargetName="GroupEnd" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
            </Trigger>
            <!-- error tint on the whole cell, under the text, in every state (after the focus trigger so it survives focus) -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content.(Validation.HasError)}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Feedback.Error.Bg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Top-left corner (select all): quiet header surface with a "#" caption instead of the default triangle -->
    <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource Brush.Bg.Header}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,1">
                        <TextBlock Text="#" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="Select all lines (Ctrl+A)"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Grid.Lines" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="RowHeight" Value="{StaticResource Size.Row}"/>
        <Setter Property="RowHeaderWidth" Value="48"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Grid.Header}"/>
        <Setter Property="RowHeaderStyle" Value="{StaticResource Grid.RowHeader}"/>
        <Setter Property="RowStyle" Value="{StaticResource Grid.Row}"/>
        <Setter Property="CellStyle" Value="{StaticResource Grid.Cell}"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <!-- Bound to an ICollectionView: without this the Selector re-syncs SelectedItem to the view's CurrentItem on every CurrentCell move and collapses multi-selection -->
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
        <Setter Property="HeadersVisibility" Value="All"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="False"/>
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Toolbar buttons: 32 px, labelled, shortcut in the tooltip, disabled not hidden -->
    <Style x:Key="Btn.Tool" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource Size.Control}"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="{StaticResource Space.Gap.Control}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Bg.Surface.Alt}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Selection.Bg}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}"/>
                            <Setter TargetName="B" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Tool}">
        <Setter Property="Background" Value="{DynamicResource Brush.Action.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2" SnapsToDevicePixels="True">
                        <Border x:Name="Ring" BorderThickness="0" BorderBrush="{DynamicResource Brush.Text.OnAccent}" CornerRadius="1" Margin="-1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Action.Primary.Hover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Action.Primary.Pressed}"/></Trigger>
                        <!-- two-tone ring so focus stays visible on the accent surface -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}"/>
                            <Setter TargetName="B" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Ring" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Border.Subtle}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Input.Filter" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="7,0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Keyboard focus visual for stock controls (CheckBox): the same 2 px ring as the retemplated controls -->
    <Style x:Key="Focus.Ring.Visual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource Brush.Focus.Ring}" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Form picker: same metrics and border language as Input.Filter -->
    <Style x:Key="Input.Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsEditable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="7,0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Form check box: 28 px rows on the 4 px grid, ring focus visual -->
    <Style x:Key="Check.Std" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring.Visual}"/>
        <Style.Triggers>
            <!-- a locked (always on) option keeps a readable label; only the box reads as disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Bar.Status" TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Header}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="{StaticResource Space.Inset.Bar}"/>
    </Style>
    <Style x:Key="Bar.Status.Item" TargetType="StatusBarItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Segment separator: a middle dot with equal 8 px gaps (replaces literal space characters) -->
    <Style x:Key="Bar.Status.Sep" TargetType="TextBlock">
        <Setter Property="Text" Value="·"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Bar.Status.Text" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Text-styled command inside the status bar (the error count jumps to the next error) -->
    <Style x:Key="Btn.Status.Link" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Feedback.Error}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="2,0" Margin="-2,0" SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" TextDecorations="Underline"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Feedback.Error.Bg}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu bar: the left edge of "File" sits on the same 16 px page inset as the title, command bar, grid, and status bar -->
    <Style x:Key="Menu.Main" TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Canvas}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
