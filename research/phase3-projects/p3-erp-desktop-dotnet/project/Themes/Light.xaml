<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic colour roles for the ERP client (light theme). Views bind with DynamicResource only. -->
    <SolidColorBrush x:Key="Brush.Bg.Canvas" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Bg.Surface.Alt" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="Brush.Bg.Header" Color="#EEF0F3"/>
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#7F8894"/>   <!-- 3.59:1 on surface: pane/control boundaries meet the 3:1 non-text floor -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1B1F24"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#5B6472"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#9AA3AF"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Action.Primary" Color="#1F5FBF"/>
    <SolidColorBrush x:Key="Brush.Action.Primary.Hover" Color="#184C99"/>
    <SolidColorBrush x:Key="Brush.Action.Primary.Pressed" Color="#123A75"/>
    <SolidColorBrush x:Key="Brush.Selection.Bg" Color="#DCE8FA"/>
    <SolidColorBrush x:Key="Brush.Selection.Border" Color="#1F5FBF"/>
    <SolidColorBrush x:Key="Brush.Focus.Ring" Color="#1F5FBF"/>
    <SolidColorBrush x:Key="Brush.Feedback.Error" Color="#B42318"/>
    <SolidColorBrush x:Key="Brush.Feedback.Error.Bg" Color="#FDECEA"/>
    <SolidColorBrush x:Key="Brush.Feedback.Warning" Color="#805400"/>   <!-- 5.77:1 on header strip (status-bar caption) -->
    <SolidColorBrush x:Key="Brush.Feedback.Warning.Bg" Color="#FFF6D6"/>
    <SolidColorBrush x:Key="Brush.Feedback.Success" Color="#1A7F37"/>
    <SolidColorBrush x:Key="Brush.Feedback.Success.Bg" Color="#E3F5E8"/>
    <SolidColorBrush x:Key="Brush.Feedback.Info.Bg" Color="#E8F0FC"/>
</ResourceDictionary>
