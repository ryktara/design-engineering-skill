<Page
    x:Class="Erp.Client.Views.InvoiceMatchingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    xmlns:models="using:Erp.Client.Models"
    xmlns:conv="using:Erp.Client.Converters"
    xmlns:vm="using:Erp.Client.ViewModels"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <!-- Supplier invoice matching. Built to the conventions already established by StockAdjustmentsPage:
         table-first working screen, high density (4 epx grid, 36 epx rows, 14 epx body), command bar with
         accelerators and access keys, status as glyph + text + colour, numerics right-aligned with tabular
         figures, theme resources instead of literal hex.
         Keyboard operability is the point of this screen: every command sits on the command bar, the row
         context menu AND an accelerator; F6 cycles the four regions; each DataGrid is a single tab stop;
         the F1 dialog lists every accelerator. -->

    <Page.Resources>
        <conv:MatchStatusToPresentationConverter x:Key="MatchStatus" />
        <conv:SignedNumberConverter x:Key="SignedNumber" />
        <conv:CountToVisibilityConverter x:Key="ZeroToVisible" ZeroIsVisible="True" />
        <conv:CountToVisibilityConverter x:Key="NonZeroToVisible" ZeroIsVisible="False" />

        <Style x:Key="NumericCellText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <!-- Header Content stays a string so DataGridColumnHeaderAutomationPeer.GetNameCore exposes it (Toolkit 7.1.2). -->
        <Style x:Key="NumericHeader" TargetType="primitives:DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="CompactCell" TargetType="controls:DataGridCell">
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Padding="16,12,16,16" RowSpacing="12">
        <Grid.KeyboardAccelerators>
            <!-- F6 / Shift+F6 cycle the four regions without tabbing through every control (desktop pane convention) -->
            <KeyboardAccelerator Key="F6" Invoked="CycleRegion_Invoked" />
            <KeyboardAccelerator Key="F6" Modifiers="Shift" Invoked="CycleRegionBack_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + command bar -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Supplier invoice matching" Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <!-- Live region: LiveSetting alone is not announced in XAML; the code-behind raises LiveRegionChanged. -->
                <TextBlock x:Name="ResultSummaryText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
            </StackPanel>

            <CommandBar x:Name="Commands" Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False"
                        OverflowButtonVisibility="Auto" AutomationProperties.Name="Invoice matching commands">
                <CommandBar.Content>
                    <TextBlock x:Name="SelectionLabelText" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{x:Bind ViewModel.SelectionLabel, Mode=OneWay}" />
                </CommandBar.Content>
                <AppBarButton Icon="Link" Label="Match" AccessKey="M"
                              Command="{x:Bind ViewModel.MatchCommand}"
                              CommandParameter="{x:Bind ViewModel.SelectedInvoice, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanMatchSelected, Mode=OneWay}"
                              ToolTipService.ToolTip="Match selected invoice (Ctrl+M)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="M" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Accept" Label="Accept variance" AccessKey="A"
                              Command="{x:Bind ViewModel.AcceptVarianceCommand}"
                              CommandParameter="{x:Bind ViewModel.SelectedLine, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanActOnLine, Mode=OneWay}"
                              ToolTipService.ToolTip="Accept the variance on the selected line (Ctrl+Shift+A)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control,Shift" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Pause" Label="Hold" AccessKey="H"
                              Command="{x:Bind ViewModel.HoldCommand}"
                              CommandParameter="{x:Bind ViewModel.SelectedInvoice, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanMatchSelected, Mode=OneWay}"
                              ToolTipService.ToolTip="Put the selected invoice on hold (Ctrl+H)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="H" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Icon="Refresh" Label="Refresh" AccessKey="R"
                              Command="{x:Bind ViewModel.RefreshCommand}"
                              ToolTipService.ToolTip="Refresh (F5)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Icon="ClearSelection" Label="Clear filters" AccessKey="L"
                                  Command="{x:Bind ViewModel.ClearFiltersCommand}"
                                  ToolTipService.ToolTip="Clear filters (Ctrl+Shift+L)">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="L" Modifiers="Control,Shift" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Icon="Keyboard" Label="Keyboard shortcuts" AccessKey="K"
                                  Click="ShowShortcuts_Click" ToolTipService.ToolTip="Keyboard shortcuts (F1)">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F1" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- Filter row: visible headers; placeholder used only as a format hint. -->
        <StackPanel x:Name="Filters" Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="SearchBox" Width="280" Header="Search" PlaceholderText="Invoice, supplier or PO"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AccessKey="S" ToolTipService.ToolTip="Search (Ctrl+F)">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
                    <!-- Escape inside the search box clears it; scoped to the box so it does not fight dialogs/flyouts -->
                    <KeyboardAccelerator Key="Escape" ScopeOwner="{x:Bind SearchBox}" Invoked="ClearSearch_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <ComboBox Width="200" Header="Match status" PlaceholderText="Any status"
                      ItemsSource="{x:Bind ViewModel.StatusOptions}"
                      SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}" />
            <Button Content="Clear filters" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ClearFiltersCommand}"
                    IsEnabled="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}" />
        </StackPanel>

        <InfoBar Grid.Row="2" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                 AutomationProperties.LiveSetting="Polite" />

        <!-- Two panes: invoices (master) and the selected invoice's match lines (detail).
             Both are bounded Height="*" regions so each DataGrid keeps a scrolling viewport and virtualises. -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <!-- Master pane is a fixed 320 epx summary list: at 1280 with the navigation pane expanded the
                 content area is ~1024 epx, and two full tables do not fit side by side. The master carries
                 the three things an operator picks an invoice by (status, identity, variance); everything
                 else about the invoice belongs to the detail pane, which gets the remaining width. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PaneBorder}">
                <Grid>
                    <controls:DataGrid x:Name="InvoiceGrid"
                                       AutomationProperties.Name="Supplier invoices"
                                       ItemsSource="{x:Bind ViewModel.FilteredInvoices, Mode=OneWay}"
                                       SelectedItem="{x:Bind ViewModel.SelectedInvoice, Mode=TwoWay}"
                                       SelectionMode="Single"
                                       AutoGenerateColumns="False"
                                       IsReadOnly="True"
                                       CanUserSortColumns="True"
                                       CanUserResizeColumns="True"
                                       RowHeight="48"
                                       CellStyle="{StaticResource CompactCell}"
                                       ColumnHeaderHeight="36"
                                       HeadersVisibility="Column"
                                       GridLinesVisibility="Horizontal"
                                       HorizontalGridLinesBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                       AlternatingRowBackground="Transparent"
                                       Sorting="InvoiceGrid_Sorting"
                                       Visibility="{x:Bind ViewModel.FilteredInvoices.Count, Mode=OneWay, Converter={StaticResource NonZeroToVisible}}">
                        <!-- One menu for the whole grid: Shift+F10 / right-click on a row. -->
                        <controls:DataGrid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Match" Icon="Link" Command="{x:Bind ViewModel.MatchCommand}"
                                                CommandParameter="{x:Bind ViewModel.SelectedInvoice, Mode=OneWay}"
                                                KeyboardAcceleratorTextOverride="Ctrl+M" />
                                <MenuFlyoutItem Text="Hold" Icon="Pause" Command="{x:Bind ViewModel.HoldCommand}"
                                                CommandParameter="{x:Bind ViewModel.SelectedInvoice, Mode=OneWay}"
                                                KeyboardAcceleratorTextOverride="Ctrl+H" />
                            </MenuFlyout>
                        </controls:DataGrid.ContextFlyout>
                        <controls:DataGrid.Columns>
                            <controls:DataGridTemplateColumn Header="Status" Width="96" CanUserSort="True" Tag="Status">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:SupplierInvoice">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0"
                                                    AutomationProperties.Name="{x:Bind Status, Converter={StaticResource MatchStatus}, ConverterParameter=Name}">
                                            <FontIcon FontSize="14"
                                                      Glyph="{x:Bind Status, Converter={StaticResource MatchStatus}, ConverterParameter=Glyph}"
                                                      Foreground="{x:Bind Status, Converter={StaticResource MatchStatus}, ConverterParameter=Brush}"
                                                      AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                                       Text="{x:Bind Status, Converter={StaticResource MatchStatus}, ConverterParameter=Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <!-- Identity: invoice number over supplier. One cell, one accessible name, so the row
                                 stays inside 320 epx and the reading order is "invoice, then supplier". -->
                            <controls:DataGridTemplateColumn Header="Invoice" Width="*" MinWidth="120" CanUserSort="True" Tag="InvoiceNumber">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:SupplierInvoice">
                                        <StackPanel Margin="8,4" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind InvoiceNumber}" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Supplier}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTemplateColumn Header="Variance (EUR)" HeaderStyle="{StaticResource NumericHeader}" Width="116" Tag="VarianceTotal" CanUserSort="True">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:SupplierInvoice">
                                        <!-- Sign always shown; colour is secondary to the sign -->
                                        <TextBlock Style="{StaticResource NumericCellText}" FontWeight="SemiBold"
                                                   Text="{x:Bind VarianceTotal, Converter={StaticResource SignedNumber}, ConverterParameter=+N2}"
                                                   Foreground="{x:Bind VarianceTotal, Converter={StaticResource SignedNumber}, ConverterParameter=Brush}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="320"
                                Visibility="{x:Bind ViewModel.FilteredInvoices.Count, Mode=OneWay, Converter={StaticResource ZeroToVisible}}">
                        <FontIcon Glyph="&#xE9D5;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"
                                   Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.EmptyBody, Mode=OneWay}" />
                        <Button HorizontalAlignment="Center" Margin="0,8,0,0"
                                Content="{x:Bind ViewModel.EmptyActionLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.EmptyActionCommand, Mode=OneWay}" />
                    </StackPanel>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.Name="Loading supplier invoices" />
                </Grid>
            </Border>

            <!-- Divider between the panes. Decorative only: F6 moves between the panes, so the divider is
                 not a focus stop and carries no automation name. -->
            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Border Grid.Column="2" Style="{StaticResource PaneBorder}">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LinesTitleText" Grid.Row="0" Margin="12,10" Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{x:Bind ViewModel.LinesTitle, Mode=OneWay}" />

                    <controls:DataGrid x:Name="LineGrid" Grid.Row="1"
                                       AutomationProperties.Name="Invoice match lines"
                                       ItemsSource="{x:Bind ViewModel.MatchLines, Mode=OneWay}"
                                       SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}"
                                       SelectionMode="Single"
                                       AutoGenerateColumns="False"
                                       IsReadOnly="True"
                                       CanUserSortColumns="False"
                                       CanUserResizeColumns="True"
                                       RowHeight="36"
                                       CellStyle="{StaticResource CompactCell}"
                                       ColumnHeaderHeight="36"
                                       HeadersVisibility="Column"
                                       GridLinesVisibility="Horizontal"
                                       HorizontalGridLinesBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                       AlternatingRowBackground="Transparent"
                                       Visibility="{x:Bind ViewModel.MatchLines.Count, Mode=OneWay, Converter={StaticResource NonZeroToVisible}}">
                        <controls:DataGrid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Accept variance" Icon="Accept" Command="{x:Bind ViewModel.AcceptVarianceCommand}"
                                                CommandParameter="{x:Bind ViewModel.SelectedLine, Mode=OneWay}"
                                                KeyboardAcceleratorTextOverride="Ctrl+Shift+A" />
                            </MenuFlyout>
                        </controls:DataGrid.ContextFlyout>
                        <controls:DataGrid.Columns>
                            <controls:DataGridTemplateColumn Header="Status" Width="96">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InvoiceMatchLine">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0"
                                                    AutomationProperties.Name="{x:Bind Status, Converter={StaticResource MatchStatus}, ConverterParameter=Name}">
                                            <FontIcon FontSize="14"
                                                      Glyph="{x:Bind Status, Converter={StaticResource MatchStatus}, ConverterParameter=Glyph}"
                                                      Foreground="{x:Bind Status, Converter={StaticResource MatchStatus}, ConverterParameter=Brush}"
                                                      AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                                                       Text="{x:Bind Status, Converter={StaticResource MatchStatus}, ConverterParameter=Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="48" />
                            <controls:DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="104" />
                            <controls:DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="100" />
                            <controls:DataGridTextColumn Header="Invoiced" HeaderStyle="{StaticResource NumericHeader}"
                                                         ElementStyle="{StaticResource NumericCellText}" Width="92"
                                                         Binding="{Binding InvoicedQuantity, Converter={StaticResource SignedNumber}, ConverterParameter=N0}" />
                            <controls:DataGridTextColumn Header="Received" HeaderStyle="{StaticResource NumericHeader}"
                                                         ElementStyle="{StaticResource NumericCellText}" Width="96"
                                                         Binding="{Binding ReceivedQuantity, Converter={StaticResource SignedNumber}, ConverterParameter=N0}" />
                            <controls:DataGridTemplateColumn Header="Variance (EUR)" HeaderStyle="{StaticResource NumericHeader}" Width="112">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InvoiceMatchLine">
                                        <TextBlock Style="{StaticResource NumericCellText}" FontWeight="SemiBold"
                                                   Text="{x:Bind ValueVariance, Converter={StaticResource SignedNumber}, ConverterParameter=+N2}"
                                                   Foreground="{x:Bind ValueVariance, Converter={StaticResource SignedNumber}, ConverterParameter=Brush}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="320"
                                Visibility="{x:Bind ViewModel.MatchLines.Count, Mode=OneWay, Converter={StaticResource ZeroToVisible}}">
                        <FontIcon Glyph="&#xE9D5;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.LinesEmptyBody, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Keyboard shortcut reference: one place that lists every accelerator on this page (F1). -->
        <ContentDialog x:Name="ShortcutsDialog" Title="Keyboard shortcuts" CloseButtonText="Close" DefaultButton="Close">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Shortcuts}" IsTabStop="False" Width="360">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShortcutInfo">
                        <Grid ColumnSpacing="16" Padding="0,4" AutomationProperties.Name="{x:Bind Description}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,2" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind Keys}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind Description}" Style="{StaticResource BodyTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentDialog>
    </Grid>
</Page>
