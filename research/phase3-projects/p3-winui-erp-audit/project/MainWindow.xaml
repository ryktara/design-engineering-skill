<Window
    x:Class="Erp.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ERP Client">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <NavigationView x:Name="Nav" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                    SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Orders" Tag="Orders" Icon="Shop" />
            <NavigationViewItem Content="Invoices" Tag="Invoices" Icon="Document" />
            <NavigationViewItemHeader Content="Warehouse" />
            <NavigationViewItem Content="Inventory" Tag="Inventory" Icon="Library" />
            <NavigationViewItem Content="Stock adjustments" Tag="StockAdjustments" Icon="Sync" IsSelected="True" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
