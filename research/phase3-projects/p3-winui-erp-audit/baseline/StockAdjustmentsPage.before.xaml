<Page
    x:Class="Erp.Client.Views.StockAdjustmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Erp.Client.Models"
    Background="#FFFFFF">

    <!-- FLAWED BASELINE (audit subject). Known problems, kept for the audit:
         ListView used as a data grid, hover-only row actions, no KeyboardAccelerators,
         colour-only status dot, placeholder-only filter fields, no empty state,
         4 px spacing everywhere, quantity columns with mixed alignment, literal hex brushes. -->

    <Grid Padding="4" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Stock adjustments" FontSize="18" Margin="4,0,0,0" />

        <!-- Toolbar: plain buttons, no labels on the icons, no accelerators, no access keys -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
            <Button Content="&#xE710;" FontFamily="Segoe Fluent Icons" Command="{x:Bind ViewModel.NewAdjustmentCommand}" />
            <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Command="{x:Bind ViewModel.RefreshCommand}" />
        </StackPanel>

        <!-- Filter bar: placeholder text is the only label -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
            <TextBox Width="220" PlaceholderText="Search" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
            <TextBox Width="120" PlaceholderText="Location" Text="{x:Bind ViewModel.LocationFilter, Mode=TwoWay}" />
            <ComboBox Width="140" PlaceholderText="Status">
                <ComboBoxItem Content="Draft" />
                <ComboBoxItem Content="Pending" />
                <ComboBoxItem Content="Posted" />
                <ComboBoxItem Content="Rejected" />
            </ComboBox>
        </StackPanel>

        <!-- ListView pretending to be a grid: header is a separate Grid so columns drift -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="4" Background="#F3F3F3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Id" FontSize="12" />
                <TextBlock Grid.Column="2" Text="SKU" FontSize="12" />
                <TextBlock Grid.Column="3" Text="Description" FontSize="12" />
                <TextBlock Grid.Column="4" Text="Loc" FontSize="12" />
                <TextBlock Grid.Column="5" Text="Reason" FontSize="12" />
                <TextBlock Grid.Column="6" Text="Before" FontSize="12" />
                <TextBlock Grid.Column="7" Text="Delta" FontSize="12" />
                <TextBlock Grid.Column="8" Text="After" FontSize="12" />
                <TextBlock Grid.Column="9" Text="Value" FontSize="12" />
                <TextBlock Grid.Column="10" Text="By" FontSize="12" />
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StockAdjustment">
                        <Grid x:Name="Row" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <!-- Status: a coloured dot only. Narrator reads nothing here. -->
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{x:Bind Status, Converter={StaticResource StatusToBrush}}" />

                            <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Sku}" FontSize="12" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Description}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Location}" FontSize="12" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Reason}" FontSize="12" />
                            <!-- Numbers: left, centre, right, left. Nothing lines up. -->
                            <TextBlock Grid.Column="6" Text="{x:Bind QuantityBefore}" FontSize="12" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="7" Text="{x:Bind QuantityDelta}" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="8" Text="{x:Bind QuantityAfter}" FontSize="12" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="9" Text="{x:Bind ValueImpact}" FontSize="12" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="10" Text="{x:Bind CreatedBy}" FontSize="12" />

                            <!-- Row actions: visible on hover only, icon glyph only, no names -->
                            <StackPanel x:Name="Actions" Grid.Column="10" Orientation="Horizontal" Spacing="2"
                                        HorizontalAlignment="Right" Visibility="Collapsed" Background="#FFFFFF">
                                <Button Content="&#xE73E;" FontFamily="Segoe Fluent Icons" Padding="2" MinWidth="20" MinHeight="20" IsTabStop="False" />
                                <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Padding="2" MinWidth="20" MinHeight="20" IsTabStop="False" />
                                <Button Content="&#xE70F;" FontFamily="Segoe Fluent Icons" Padding="2" MinWidth="20" MinHeight="20" IsTabStop="False" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- No empty state, no loading state: an empty list is just white space. -->
        </Grid>
    </Grid>
</Page>
