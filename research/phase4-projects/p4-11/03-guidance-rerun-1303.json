    {
      "id": "media-resume-and-details",
      "kind": "component",
      "category": "detail",
      "title": "Media details screen, resume playback and watchlist",
      "facets": [
        "component",
        "platform"
      ],
      "concerns": [
        "component",
        "interaction",
        "navigation",
