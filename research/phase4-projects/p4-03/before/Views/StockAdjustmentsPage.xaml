<Page
    x:Class="Erp.Client.Views.StockAdjustmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:Erp.Client.Models"
    xmlns:conv="using:Erp.Client.Converters"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <!-- Refactored after the design-engineering audit.
         Direction: table-first working screen, high density (4 epx grid, 36 epx rows, 14 epx body),
         command bar with accelerators, status as icon + text, numerics right-aligned with tabular figures,
         visible field headers, empty/loading states, theme resources instead of literal hex. -->

    <Page.Resources>
        <conv:StatusToPresentationConverter x:Key="StatusPresentation" />
        <conv:SignedNumberConverter x:Key="SignedNumber" />
        <conv:RowActionNameConverter x:Key="RowActionName" />
        <conv:CountToVisibilityConverter x:Key="ZeroToVisible" ZeroIsVisible="True" />
        <conv:CountToVisibilityConverter x:Key="NonZeroToVisible" ZeroIsVisible="False" />

        <!-- Numeric cell: right-aligned, tabular lining figures, one precision per column -->
        <Style x:Key="NumericCellText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style x:Key="NumericHeader" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="CompactCell" TargetType="controls:DataGridCell">
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Padding="16,12,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + command bar. Accelerators shown in tooltips, access keys on Alt. -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Stock adjustments" Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
            </StackPanel>

            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                <AppBarButton Icon="Add" Label="New adjustment" AccessKey="N"
                              Command="{x:Bind ViewModel.NewAdjustmentCommand}"
                              ToolTipService.ToolTip="New adjustment (Ctrl+N)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Accept" Label="Approve" AccessKey="A"
                              Command="{x:Bind ViewModel.ApproveCommand}"
                              CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanApproveSelected, Mode=OneWay}"
                              ToolTipService.ToolTip="Approve selected (Ctrl+Shift+A)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control,Shift" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Cancel" Label="Reject" AccessKey="J"
                              Command="{x:Bind ViewModel.RejectCommand}"
                              CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanApproveSelected, Mode=OneWay}"
                              ToolTipService.ToolTip="Reject selected (Ctrl+Shift+R)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control,Shift" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Icon="Refresh" Label="Refresh" AccessKey="R"
                              Command="{x:Bind ViewModel.RefreshCommand}"
                              ToolTipService.ToolTip="Refresh (F5)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- Filter row: visible headers; placeholder used only as a format hint. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="SearchBox" Width="280" Header="Search" PlaceholderText="Id, SKU or description"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AccessKey="S" ToolTipService.ToolTip="Search (Ctrl+F)">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <TextBox Width="140" Header="Location" PlaceholderText="e.g. A-01-03"
                     Text="{x:Bind ViewModel.LocationFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="180" Header="Status" PlaceholderText="Any status"
                      ItemsSource="{x:Bind ViewModel.StatusOptions}"
                      SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}" />
            <Button Content="Clear filters" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ClearFiltersCommand}"
                    IsEnabled="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}" />
        </StackPanel>

        <!-- Feedback (approve/reject result, errors): announced politely, never focus-stealing -->
        <InfoBar Grid.Row="2" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                 AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="{StaticResource OverlayCornerRadius}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <controls:DataGrid x:Name="Grid"
                               AutomationProperties.Name="Stock adjustments"
                               ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
                               SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                               SelectionMode="Single"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               CanUserSortColumns="True"
                               CanUserResizeColumns="True"
                               CanUserReorderColumns="True"
                               RowHeight="36"
                               CellStyle="{StaticResource CompactCell}"
                               ColumnHeaderHeight="36"
                               HeadersVisibility="Column"
                               GridLinesVisibility="Horizontal"
                               HorizontalGridLinesBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                               AlternatingRowBackground="Transparent"
                               Sorting="Grid_Sorting"
                               Visibility="{x:Bind ViewModel.FilteredItems.Count, Mode=OneWay, Converter={StaticResource NonZeroToVisible}}">
                <controls:DataGrid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Edit" Icon="Edit" Command="{x:Bind ViewModel.EditCommand}"
                                        CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F2" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Approve" Icon="Accept" Command="{x:Bind ViewModel.ApproveCommand}"
                                        CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}" />
                        <MenuFlyoutItem Text="Reject" Icon="Cancel" Command="{x:Bind ViewModel.RejectCommand}"
                                        CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}" />
                    </MenuFlyout>
                </controls:DataGrid.ContextFlyout>
                <controls:DataGrid.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F2" Invoked="EditSelected_Invoked" />
                </controls:DataGrid.KeyboardAccelerators>

                <controls:DataGrid.Columns>
                    <!-- Status: icon + text, one accessible name for the cell -->
                    <controls:DataGridTemplateColumn Header="Status" Width="108" CanUserSort="True" Tag="Status">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:StockAdjustment">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0"
                                            AutomationProperties.Name="{x:Bind Status, Converter={StaticResource StatusPresentation}, ConverterParameter=Name}">
                                    <FontIcon FontSize="14"
                                              Glyph="{x:Bind Status, Converter={StaticResource StatusPresentation}, ConverterParameter=Glyph}"
                                              Foreground="{x:Bind Status, Converter={StaticResource StatusPresentation}, ConverterParameter=Brush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                                               Text="{x:Bind Status, Converter={StaticResource StatusPresentation}, ConverterParameter=Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTextColumn Header="Adjustment" Binding="{Binding Id}" Width="96" Tag="Id" />
                    <controls:DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="112" Tag="Sku" />
                    <controls:DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="160" Tag="Description" />
                    <controls:DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="80" Tag="Location" />
                    <controls:DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="96" Tag="Reason" />

                    <!-- Numeric columns: header right-aligned, unit in the header, tabular figures -->
                    <controls:DataGridTemplateColumn Width="76" Tag="QuantityBefore" CanUserSort="True">
                        <controls:DataGridTemplateColumn.Header>
                            <TextBlock Text="Before" Style="{StaticResource NumericHeader}" />
                        </controls:DataGridTemplateColumn.Header>
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:StockAdjustment">
                                <TextBlock Style="{StaticResource NumericCellText}" Text="{x:Bind QuantityBefore, Converter={StaticResource SignedNumber}, ConverterParameter=N0}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Width="76" Tag="QuantityDelta" CanUserSort="True">
                        <controls:DataGridTemplateColumn.Header>
                            <TextBlock Text="Change" Style="{StaticResource NumericHeader}" />
                        </controls:DataGridTemplateColumn.Header>
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:StockAdjustment">
                                <!-- Sign always shown; colour is secondary to the sign -->
                                <TextBlock Style="{StaticResource NumericCellText}" FontWeight="SemiBold"
                                           Text="{x:Bind QuantityDelta, Converter={StaticResource SignedNumber}, ConverterParameter=+N0}"
                                           Foreground="{x:Bind QuantityDelta, Converter={StaticResource SignedNumber}, ConverterParameter=Brush}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Width="76" Tag="QuantityAfter" CanUserSort="True">
                        <controls:DataGridTemplateColumn.Header>
                            <TextBlock Text="After" Style="{StaticResource NumericHeader}" />
                        </controls:DataGridTemplateColumn.Header>
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:StockAdjustment">
                                <TextBlock Style="{StaticResource NumericCellText}" Text="{x:Bind QuantityAfter, Converter={StaticResource SignedNumber}, ConverterParameter=N0}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Width="88" Tag="ValueImpact" CanUserSort="True">
                        <controls:DataGridTemplateColumn.Header>
                            <TextBlock Text="Value (EUR)" Style="{StaticResource NumericHeader}" />
                        </controls:DataGridTemplateColumn.Header>
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:StockAdjustment">
                                <TextBlock Style="{StaticResource NumericCellText}" Text="{x:Bind ValueImpact, Converter={StaticResource SignedNumber}, ConverterParameter=+N2}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!-- Hidden by default to keep the table inside a 1088 epx content area at 1440 wide; a column chooser (persisted) is the intended way to show it. -->
                    <controls:DataGridTextColumn Header="Created by" Binding="{Binding CreatedBy}" Width="96" Tag="CreatedBy" Visibility="Collapsed" />

                    <!-- Row actions: always visible, tab-reachable, named; mirrored in the context menu and command bar -->
                    <controls:DataGridTemplateColumn Header="Actions" Width="108" CanUserSort="False" CanUserReorder="False">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:StockAdjustment">
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RowActionButton}"
                                            AutomationProperties.Name="{x:Bind Id, Converter={StaticResource RowActionName}, ConverterParameter=Edit}"
                                            ToolTipService.ToolTip="Edit (F2)"
                                            Command="{Binding ElementName=Grid, Path=DataContext.EditCommand}" CommandParameter="{x:Bind}">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource RowActionButton}"
                                            AutomationProperties.Name="{x:Bind Id, Converter={StaticResource RowActionName}, ConverterParameter=Approve}"
                                            ToolTipService.ToolTip="Approve (Ctrl+Shift+A)"
                                            IsEnabled="{x:Bind IsActionable}"
                                            Command="{Binding ElementName=Grid, Path=DataContext.ApproveCommand}" CommandParameter="{x:Bind}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource RowActionButton}"
                                            AutomationProperties.Name="{x:Bind Id, Converter={StaticResource RowActionName}, ConverterParameter=Reject}"
                                            ToolTipService.ToolTip="Reject (Ctrl+Shift+R)"
                                            IsEnabled="{x:Bind IsActionable}"
                                            Command="{Binding ElementName=Grid, Path=DataContext.RejectCommand}" CommandParameter="{x:Bind}">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>

            <!-- Empty state: same region as the table, one heading, one sentence, one action -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360"
                        Visibility="{x:Bind ViewModel.FilteredItems.Count, Mode=OneWay, Converter={StaticResource ZeroToVisible}}">
                <FontIcon Glyph="&#xE9D5;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"
                           Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.EmptyBody, Mode=OneWay}" />
                <Button HorizontalAlignment="Center" Margin="0,8,0,0"
                        Content="{x:Bind ViewModel.EmptyActionLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.EmptyActionCommand, Mode=OneWay}" />
            </StackPanel>

            <!-- Loading -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Loading stock adjustments" />
        </Grid>
    </Grid>
</Page>
