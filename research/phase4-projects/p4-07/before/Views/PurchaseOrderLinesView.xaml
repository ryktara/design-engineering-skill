<UserControl x:Class="ErpClient.Views.PurchaseOrderLinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ErpClient.Views"
             xmlns:vm="clr-namespace:ErpClient.ViewModels"
             d:DataContext="{d:DesignInstance vm:PurchaseOrderLinesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Brush.Bg.Canvas}"
             FontFamily="{StaticResource Font.UI}" FontSize="{StaticResource Font.Size.Body}"
             Foreground="{DynamicResource Brush.Text.Primary}"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <v:NonEmptyToVisibilityConverter x:Key="TextToVis"/>
        <v:HasErrorsToVisibilityConverter x:Key="ErrToVis"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Insert" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoDeleteCommand}"/>
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Menu bar: the complete command set with accelerators; toolbar carries the frequent subset -->
        <Menu DockPanel.Dock="Top" Style="{StaticResource Menu.Main}" KeyboardNavigation.TabNavigation="Once">
            <MenuItem Header="_File">
                <MenuItem Header="_Save lines" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Reload" Command="{Binding ReloadCommand}" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Add line" Command="{Binding AddLineCommand}" InputGestureText="Ins"/>
                <MenuItem Header="D_uplicate" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D"/>
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                <MenuItem Header="_Undo delete" Command="{Binding UndoDeleteCommand}" InputGestureText="Ctrl+Z"/>
                <Separator/>
                <MenuItem Header="Set _status" ItemsSource="{Binding Statuses}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=v:PurchaseOrderLinesView}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Set _warehouse" ItemsSource="{Binding Warehouses}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.SetWarehouseCommand, RelativeSource={RelativeSource AncestorType=v:PurchaseOrderLinesView}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ColumnsMenu" Header="_Columns"/>
                <MenuItem Header="_Reset column layout" Click="OnResetColumns"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard shortcuts" Click="OnShowShortcuts" InputGestureText="F1"/>
            </MenuItem>
        </Menu>

        <!-- Title band: one focal point (order), context as secondary text -->
        <Grid DockPanel.Dock="Top" Margin="16,12,16,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Purchase order lines"/>
                <TextBlock Style="{StaticResource Text.Body}" Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{DynamicResource Brush.Text.Secondary}">
                    <Run FontFamily="{StaticResource Font.Mono}" FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding OrderNumber, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Supplier, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Currency, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Command bar: selection-driven commands, disabled not hidden, count next to the commands, filter on the right -->
        <Grid DockPanel.Dock="Top" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <Button x:Name="AddButton" Style="{StaticResource Btn.Primary}" Content="_Add line" Command="{Binding AddLineCommand}" ToolTip="Add a line after the current one (Ins, Ctrl+N)" AutomationProperties.HelpText="Insert"/>
                <Button Style="{StaticResource Btn.Tool}" Content="D_uplicate" Command="{Binding DuplicateCommand}" ToolTip="Duplicate selected lines (Ctrl+D)"/>
                <Button Style="{StaticResource Btn.Tool}" Content="_Delete" Command="{Binding DeleteCommand}" ToolTip="Delete selected lines; Ctrl+Z restores them (Del)"/>
                <Button x:Name="StatusButton" Style="{StaticResource Btn.Tool}" Content="Set _status ▾" Click="OnOpenStatusMenu" IsEnabled="{Binding HasSelection}" ToolTip="Set the status of the selected lines">
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding Statuses}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding}"/>
                                    <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="WarehouseButton" Style="{StaticResource Btn.Tool}" Content="_Warehouse ▾" Click="OnOpenWarehouseMenu" IsEnabled="{Binding HasSelection}" ToolTip="Move the selected lines to a warehouse">
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding Warehouses}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding}"/>
                                    <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.SetWarehouseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource Btn.Tool}" Content="_More ▾" Click="OnOpenMoreMenu" IsEnabled="{Binding HasSelection}" Visibility="Collapsed" ToolTip="Set status or warehouse for the selected lines">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Set _status" ItemsSource="{Binding Statuses}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding}"/>
                                        <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <MenuItem Header="Set _warehouse" ItemsSource="{Binding Warehouses}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding}"/>
                                        <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.SetWarehouseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Rectangle Width="1" Height="20" Fill="{DynamicResource Brush.Border.Strong}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Tool}" Content="_Save" Command="{Binding SaveCommand}" ToolTip="Save all lines (Ctrl+S); disabled while any line has an error"/>
                <TextBlock Style="{StaticResource Text.Body}" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="{Binding SelectionSummary}" Visibility="{Binding SelectionSummary, Converter={StaticResource TextToVis}}"/>
            </StackPanel>
            <Grid x:Name="FilterHost" Grid.Column="1" Width="260" Margin="16,0,0,0">
                <TextBox x:Name="FilterBox" Style="{StaticResource Input.Filter}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         AutomationProperties.Name="Filter lines" ToolTip="Filter by item, description, warehouse, status, or note (Ctrl+F)"/>
                <TextBlock IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Text="Filter lines  Ctrl+F">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="✕" Command="{Binding ClearFilterCommand}" HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,2,0" BorderThickness="0" Background="Transparent"
                        Foreground="{DynamicResource Brush.Text.Secondary}" ToolTip="Clear filter (Esc)" AutomationProperties.Name="Clear filter"
                        Visibility="{Binding FilterText, Converter={StaticResource TextToVis}}"/>
            </Grid>
        </Grid>

        <!-- Status bar: message · counts · errors · unsaved · hidden columns | totals -->
        <StatusBar DockPanel.Dock="Bottom" Style="{StaticResource Bar.Status}" KeyboardNavigation.TabNavigation="None">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" HorizontalContentAlignment="Stretch">
                <StackPanel Orientation="Horizontal" ClipToBounds="True">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Text.Primary}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="  ·  " /><TextBlock Text="{Binding CountSummary}"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding SelectionSummary, Converter={StaticResource TextToVis}}">
                        <TextBlock Text="  ·  " /><TextBlock Text="{Binding SelectionSummary}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ErrorSummary, Converter={StaticResource TextToVis}}">
                        <TextBlock Text="  ·  " /><TextBlock Text="! " FontWeight="Bold" Foreground="{DynamicResource Brush.Feedback.Error}"/><TextBlock Text="{Binding ErrorSummary}" Foreground="{DynamicResource Brush.Feedback.Error}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding DirtySummary, Converter={StaticResource TextToVis}}">
                        <TextBlock Text="  ·  " /><TextBlock Text="{Binding DirtySummary}" Foreground="{DynamicResource Brush.Feedback.Warning}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HiddenColumnsText, Converter={StaticResource TextToVis}}">
                        <TextBlock Text="  ·  " /><TextBlock Text="{Binding HiddenColumnsText}"/>
                    </StackPanel>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Center" Margin="16,0">
                <TextBlock x:Name="KeyHints" Text="F2 edit · Enter next row · Tab next cell · Ins new line · Del delete · Ctrl+Z undo" Foreground="{DynamicResource Brush.Text.Secondary}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Typography.NumeralAlignment="Tabular">
                    <StackPanel x:Name="TotalsDetail" Orientation="Horizontal">
                        <TextBlock Text="Subtotal "/><TextBlock Text="{Binding Subtotal, StringFormat=N2}" Foreground="{DynamicResource Brush.Text.Primary}" MinWidth="88" TextAlignment="Right"/>
                        <TextBlock Text="   Tax "/><TextBlock Text="{Binding TaxTotal, StringFormat=N2}" Foreground="{DynamicResource Brush.Text.Primary}" MinWidth="72" TextAlignment="Right"/>
                        <TextBlock Text="   "/>
                    </StackPanel>
                    <TextBlock Text="Total "/><TextBlock Text="{Binding GrandTotal, StringFormat=N2}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" MinWidth="96" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Currency, StringFormat=' {0}'}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Content: grid fills the remaining height with internal scrolling; states overlay it -->
        <Grid Margin="16,0,16,12">
            <DataGrid x:Name="LinesGrid" Style="{StaticResource Grid.Lines}" ItemsSource="{Binding LinesView}"
                      Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="Purchase order lines"
                      SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnGridPreviewKeyDown"
                      BeginningEdit="OnBeginningEdit" CellEditEnding="OnCellEditEnding" SizeChanged="OnGridSizeChanged"
                      RowEditEnding="OnRowEditEnding">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Add line" Command="{Binding AddLineCommand}" InputGestureText="Ins"/>
                        <MenuItem Header="D_uplicate" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D"/>
                        <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                        <Separator/>
                        <MenuItem Header="Set _status" ItemsSource="{Binding Statuses}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding}"/>
                                    <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Set _warehouse" ItemsSource="{Binding Warehouses}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding}"/>
                                    <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.SetWarehouseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <!-- Essential columns have no HideBelow. Priority order of disappearance: Notes, Tax, Discount, Requested, Unit, Warehouse, Status. -->
                    <DataGridTextColumn x:Name="ColItem" Header="Item" Width="132" MinWidth="96" Binding="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource Text.Cell.Mono}" EditingElementStyle="{StaticResource Edit.Cell.Mono}"/>
                    <DataGridTextColumn x:Name="ColDescription" Header="Description" Width="3*" MinWidth="180" Binding="{Binding Description}"
                                        ElementStyle="{StaticResource Text.Cell}" EditingElementStyle="{StaticResource Edit.Cell}"/>
                    <DataGridTextColumn x:Name="ColQty" Header="Qty" Width="76" MinWidth="64" Binding="{Binding Quantity, StringFormat=N2}"
                                        HeaderStyle="{StaticResource Grid.Header.Numeric}" ElementStyle="{StaticResource Text.Numeric}" EditingElementStyle="{StaticResource Edit.Cell.Numeric}"/>
                    <DataGridComboBoxColumn x:Name="ColUnit" Header="Unit" Width="72" MinWidth="60" v:ColumnPriority.HideBelow="1020"
                                            SelectedItemBinding="{Binding Unit}" ElementStyle="{StaticResource Elem.Cell.Combo}" EditingElementStyle="{StaticResource Edit.Cell.Combo}"/>
                    <DataGridTextColumn x:Name="ColPrice" Header="Unit price" Width="100" MinWidth="84" Binding="{Binding UnitPrice, StringFormat=N2}"
                                        HeaderStyle="{StaticResource Grid.Header.Numeric}" ElementStyle="{StaticResource Text.Numeric}" EditingElementStyle="{StaticResource Edit.Cell.Numeric}"/>
                    <DataGridTextColumn x:Name="ColDiscount" Header="Disc %" Width="72" MinWidth="60" v:ColumnPriority.HideBelow="1200" Binding="{Binding DiscountPct, StringFormat=N1}"
                                        HeaderStyle="{StaticResource Grid.Header.Numeric}" ElementStyle="{StaticResource Text.Numeric}" EditingElementStyle="{StaticResource Edit.Cell.Numeric}"/>
                    <DataGridTextColumn x:Name="ColTax" Header="Tax %" Width="64" MinWidth="56" v:ColumnPriority.HideBelow="1280" Binding="{Binding TaxPct, StringFormat=N1}"
                                        HeaderStyle="{StaticResource Grid.Header.Numeric}" ElementStyle="{StaticResource Text.Numeric}" EditingElementStyle="{StaticResource Edit.Cell.Numeric}"/>
                    <DataGridTextColumn x:Name="ColTotal" Header="Line total" Width="112" MinWidth="96" IsReadOnly="True" Binding="{Binding LineTotal, StringFormat=N2, Mode=OneWay}"
                                        HeaderStyle="{StaticResource Grid.Header.Numeric}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridComboBoxColumn x:Name="ColWarehouse" Header="Warehouse" Width="120" MinWidth="100" v:ColumnPriority.HideBelow="940"
                                            SelectedItemBinding="{Binding Warehouse}" ElementStyle="{StaticResource Elem.Cell.Combo}" EditingElementStyle="{StaticResource Edit.Cell.Combo}"/>
                    <DataGridTextColumn x:Name="ColRequested" Header="Requested" Width="104" MinWidth="96" v:ColumnPriority.HideBelow="1100" Binding="{Binding RequestedDate, StringFormat=yyyy-MM-dd}"
                                        ElementStyle="{StaticResource Text.Cell}" EditingElementStyle="{StaticResource Edit.Cell}"/>
                    <DataGridComboBoxColumn x:Name="ColStatus" Header="Status" Width="132" MinWidth="104" v:ColumnPriority.HideBelow="860"
                                            SelectedItemBinding="{Binding Status}" ElementStyle="{StaticResource Elem.Cell.Combo}" EditingElementStyle="{StaticResource Edit.Cell.Combo}"/>
                    <DataGridTextColumn x:Name="ColNotes" Header="Notes" Width="*" MinWidth="120" v:ColumnPriority.HideBelow="1380" Binding="{Binding Notes}"
                                        ElementStyle="{StaticResource Text.Cell.Secondary}" EditingElementStyle="{StaticResource Edit.Cell}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state lives inside the table body, below the (still visible) header -->
            <Border Margin="1,33,1,1" Background="{DynamicResource Brush.Bg.Surface}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" IsHitTestVisible="True">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="No lines on this order yet" TextAlignment="Center"/>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,12" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Add the first line, then keep typing: Enter moves to the next row and adds one at the end."/>
                    <Button Style="{StaticResource Btn.Primary}" Content="_Add first line" Command="{Binding AddLineCommand}" HorizontalAlignment="Center" Margin="0" ToolTip="Ins"/>
                </StackPanel>
            </Border>

            <!-- Loading state: the real header stays visible; the body shows an indeterminate bar -->
            <Border Margin="1,33,1,1" Background="{DynamicResource Brush.Bg.Surface}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                        <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource Brush.Action.Primary}" Background="{DynamicResource Brush.Border.Subtle}" BorderThickness="0"
                                     AutomationProperties.Name="Loading purchase order lines"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextAlignment="Center" Text="{Binding StatusMessage}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Error state: what failed, and the one action that recovers; Retry is the default button -->
            <Border Background="{DynamicResource Brush.Bg.Surface}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                    Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                <Border VerticalAlignment="Top" Margin="0" Background="{DynamicResource Brush.Feedback.Error.Bg}" BorderBrush="{DynamicResource Brush.Feedback.Error}" BorderThickness="0,0,0,2" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" Background="{DynamicResource Brush.Feedback.Error}" CornerRadius="10" Margin="0,2,12,0" VerticalAlignment="Top">
                            <TextBlock Text="!" Foreground="{DynamicResource Brush.Text.OnAccent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Could not load the lines for this order" AutomationProperties.LiveSetting="Assertive"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" Text="{Binding ErrorMessage}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Text="Your unsaved edits are kept locally. Retry now, or reload later with F5."/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="_Retry" Command="{Binding ReloadCommand}" Margin="16,0,0,0" VerticalAlignment="Top" IsDefault="True" ToolTip="F5"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
