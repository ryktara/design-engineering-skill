    {
      "id": "tv-dpad-axes",
      "kind": "rule",
      "category": "navigation",
      "title": "TV: vertical = sections, horizontal = items",
      "facets": [
        "navigation",
        "platform"
      ],
      "concerns": [
        "interaction",
        "navigation"
      ],
      "concepts": [
        "interaction.dpad_reachability"
      ],
      "covers": [
        "D-pad focus reachability"
      ],
      "score": 0.378,
      "guidance": "Every focusable element must be reachable with straight UP/DOWN/LEFT/RIGHT presses; no diagonal reasoning, no hidden hops. Search and settings live at a predictable edge. Grids: LEFT at the first column may enter side navigation, RIGHT at the last column stays. Forms: one field per row, DOWN advances.",
      "use_when": "Any TV layout: rails, grids, menus, settings, forms.",
      "avoid_when": "Avoid nested horizontal groups inside horizontal groups; avoid controls placed where no straight DPAD path reaches them.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "platform-standard",
