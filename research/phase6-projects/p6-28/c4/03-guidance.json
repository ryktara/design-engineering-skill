      ],
      "covers": [
        "auto-hide timing of player controls",
        "accessible names and labels",
        "subtitle and audio track selection reachable from the player"
      ],
      "score": 0.762,
      "guidance": "Play/pause, seek slider with time readout and keyboard/remote stepping, skip ±10 s, next/previous where relevant, captions and audio track selectors, quality only if user-facing, live indicator and go-to-live for live streams, volume on web/desktop only (TV uses the remote), controls overlay auto-hides except while focused/hovered; every control labelled; captions styling respects system preferences.",
      "use_when": "Video/audio playback surfaces.",
      "avoid_when": "Never custom-build when the platform control set already meets the need and the brand allows it.",
      "risk": {
        "a11y": "high",
        "perf": "medium"
      },
      "provenance": "platform-standard",
      "implementation": {
        "html-css": "<video> + custom controls with role=slider for seek; media-chrome web components are a solid base."
      },
      "why": {
        "lexical": 0.632,
        "structural": 0.92,
        "matched": [
          "platform tv",
          "input remote (stated)",
          "mode audit",
          "product media",
          "screen player"
        ]
      },
      "role": "core",
      "selected_for": "task evidence: screen, component, product, lexical_strong"
    },
    {
      "id": "layout-split-player",
      "kind": "pattern",
      "category": "layout",
      "title": "Player with overlay controls",
      "facets": [
