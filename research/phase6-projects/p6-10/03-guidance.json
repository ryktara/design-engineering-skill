    {
      "id": "impl-reuse-before-new",
      "kind": "rule",
      "category": "implementation",
      "title": "Reuse → extend → compose → new (in that order)",
      "facets": [
        "process"
      ],
      "concerns": [
        "structure"
      ],
      "concepts": [
        "process.reuse_first"
      ],
      "covers": [
        "reuse → extend → compose → new"
      ],
      "score": 0.261,
      "guidance": "Inspect the repository first (inspect_project.py): existing components, tokens, fonts, breakpoints, and conventions win. Reuse the existing component; if it lacks a variant, extend it through its API; if the composition is new, compose existing primitives; only create a new primitive when the gap is real, and put it where the others live.",
      "use_when": "Any UI change in an existing codebase.",
      "avoid_when": "Never install a second component library or a UI framework to build one screen; never fork a design-system component when a variant prop would do.",
      "risk": {
        "a11y": "low",
        "perf": "medium"
      },
      "provenance": "engineering-practice",
      "why": {
