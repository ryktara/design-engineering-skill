    },
    {
      "id": "interaction-drag-drop",
      "kind": "rule",
      "category": "input",
      "title": "Drag and drop: affordance, feedback, keyboard alternative, no layout thrash",
      "facets": [
        "interaction",
        "platform"
      ],
      "concerns": [
        "interaction"
      ],
      "concepts": [
        "touch.gestures_discoverable",
        "interaction.keyboard_navigation",
        "a11y.live_status",
        "perf.layout_shift"
      ],
      "covers": [
        "discoverable gestures",
        "keyboard navigation and focus order",
        "live region status announcements",
        "no layout shift"
      ],
      "score": 0.443,
      "guidance": "Show a grip or lift affordance; on lift raise the item (shadow/scale) and move it with a transform only; show a snapped drop target with the value it will take (time slot, column); write state once on drop; provide a keyboard/button alternative (arrow keys or a 'Move to…' menu) with focus kept on the moved item; announce the result in a live region; Escape cancels; respect reduced motion.",
      "use_when": "Reordering, rescheduling, moving cards between columns, dragging chips in a grid.",
      "avoid_when": "Never make drag the only way (WCAG 2.5.7); never re-render the whole collection on every pointer move; never drop without a visible target and a result announcement.",
