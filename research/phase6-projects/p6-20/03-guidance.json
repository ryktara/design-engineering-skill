  "guardrails": [
    {
      "id": "grid-single-tab-stop",
      "kind": "rule",
      "category": "table",
      "title": "Grids with row actions are one Tab stop",
      "facets": [
        "component",
        "platform"
      ],
      "concerns": [
        "accessibility",
        "data-display",
        "interaction"
      ],
      "concepts": [
        "interaction.keyboard_navigation",
        "interaction.focus_visible",
        "table.selection_bulk",
        "interaction.selection_visible"
      ],
      "covers": [
        "keyboard navigation and focus order",
        "visible focus",
        "selection state and bulk actions",
        "selected state visible and distinct from focus and hover"
      ],
      "score": 0.599,
      "guidance": "Tab enters the grid once and leaves it once; arrow keys move between cells/rows (roving tabindex or a focus manager), Enter/Space activates the focused cell's action, Escape returns from an edited cell to navigation mode; row actions become reachable when the row or actions cell is focused and are also available from a row context/actions menu; a table with 24 rows must never produce 24 Tab stops per action column. Announce the current row/column (aria-rowindex/colindex or the platform's automation properties) and keep a visible focus indicator on the active cell.",
      "use_when": "Data tables or grids where each row has buttons/links (edit, delete, approve, download) and there are more than a handful of rows.",
      "avoid_when": "Small static tables with no interactive cells.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "accessibility-requirement",
      "implementation": {
        "winui": "DataGrid: KeyboardNavigation.TabNavigation=Once, cell focus via SelectionUnit=Cell; expose row actions in a CommandBarFlyout on Menu key / Shift+F10."
      },
      "why": {
        "lexical": 0.5,
        "structural": 0.72,
        "matched": [
          "platform desktop",
          "input keyboard,pointer",
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "most relevant record for the request wording"
    },
    {
      "id": "data-exceptions-first",
      "kind": "rule",
      "category": "feedback",
      "title": "Exceptions first: surface what needs attention in lists and tables",
      "facets": [
        "component"
      ],
      "concerns": [
        "accessibility",
        "data-display",
        "feedback"
      ],
      "concepts": [
        "data.exception_first",
        "a11y.color_not_only",
        "env.glanceable_status",
        "table.tabular_figures"
      ],
      "covers": [
        "exceptions and anomalies first",
        "no colour alone for status",
        "glanceable status",
        "tabular figures and numeric alignment"
      ],
      "score": 0.317,
      "guidance": "Compute the status in the model and show it as a column or badge with a word plus icon plus colour; sort or group exceptions first (or offer a one-tap 'only overdue' filter); show a count in the header/status bar; keep the row otherwise unchanged so scanning stays fast; state the rule that makes an item an exception (e.g. '> 90 days since service').",
      "use_when": "Any collection where some items need action (overdue, late, failed, expiring, over budget) and the user should see them without opening each one.",
      "avoid_when": "Never rely on colour alone for the status; never bury the exception state inside the detail view; never sort exceptions below normal rows by default.",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "heuristic",
      "why": {
