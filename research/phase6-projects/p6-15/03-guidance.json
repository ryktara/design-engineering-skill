      "score": 0.559,
      "guidance": "Set keyboard type and autocomplete/textContentType/autofillHints per field, return key action (Next/Done), scroll the focused field above the keyboard, keep the primary action reachable while the keyboard is open (or on the keyboard toolbar), and dismiss on tap outside for non-modal forms.",
      "use_when": "Every text field.",
      "avoid_when": "Never leave the default keyboard for emails, numbers, phone, or URLs; never let the keyboard cover the focused field or the submit button.",
      "risk": {
        "a11y": "medium",
