  "guardrails": [
    {
      "id": "layout-states-empty-loading-error",
      "kind": "rule",
      "category": "feedback",
      "title": "Design empty, loading, error, and partial states",
      "facets": [
        "component"
      ],
      "concerns": [
        "states"
      ],
      "concepts": [
        "state.loading_empty_error"
      ],
      "covers": [
        "loading, empty and error states"
      ],
      "score": 0.293,
      "guidance": "Empty: what this is, why it is empty, one action. Loading: skeleton with final dimensions, then content; announce completion. Error: what failed, what to do, retry that works; keep entered data. Partial: show what loaded, mark what didn't. On TV, focus must land somewhere valid in each state.",
      "use_when": "Every list, table, chart, form, and detail screen.",
      "avoid_when": "Never ship a blank area for empty data; never show a spinner for more than ~1 s without a skeleton or progress; never show an error without a next step.",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "heuristic",
      "why": {
        "lexical": 0.059,
        "structural": 0.58,
        "matched": [
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "required coverage (GENERIC): loading, empty and error states"
    },
    {
      "id": "layout-hierarchy-one-thing",
      "kind": "rule",
      "category": "layout",
      "title": "One clear focal point per screen",
      "facets": [
        "layout"
      ],
      "concerns": [
        "data-display",
        "structure"
      ],
      "concepts": [
        "layout.focal_hierarchy",
        "layout.one_primary_action",
        "data.exception_first"
      ],
      "covers": [
        "visual hierarchy with one focal point",
        "one primary action per view",
        "exceptions and anomalies first"
      ],
      "score": 0.261,
      "guidance": "Decide the screen's job and the one element that serves it; give that element the strongest size/contrast/position; demote everything else by one or two steps; navigation and chrome are quieter than content. On dashboards the focal point is the most important metric or the anomaly, not the page title.",
      "use_when": "Designing any screen; reviewing 'it looks busy'.",
      "avoid_when": "Never give three elements the same maximum emphasis; never make the primary content compete with chrome.",
      "risk": {
        "a11y": "low",
        "perf": "low"
      },
      "provenance": "heuristic",
      "why": {
        "lexical": 0.0,
        "structural": 0.58,
        "matched": [
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "specialist rule for one primary action per view (only covered by a composite record)"
    },
    {
      "id": "ecommerce-delivery-promise",
      "kind": "rule",
      "category": "content",
      "title": "Delivery promise and returns stated next to the price",
      "facets": [
        "platform",
        "visual"
      ],
      "concerns": [
        "content",
        "feedback"
      ],
      "concepts": [
        "feedback.trust_signals",
        "content.readable_measure"
      ],
      "covers": [
        "trust and cost transparency before commitment",
        "readable line length"
      ],
      "score": 0.422,
      "guidance": "Under the price show the delivery window as dates ('Fri 11 – Tue 15 Sep', with <time>), the cost ('Free delivery'), a order-deadline countdown ('Order within 3 h to ship today') that updates without a live region, the return terms in one line ('Free 60-day returns · prepaid label'), and stock in words; repeat the promise in the cart and at checkout unchanged.",
      "use_when": "Product pages and carts: shoppers decide on arrival date, delivery cost and return terms before they add to cart.",
      "avoid_when": "Never hide delivery and returns in a tab; never show a vague 'ships soon'; never state a date without the order deadline that makes it true.",
      "risk": {
        "a11y": "low",
        "perf": "low"
      },
      "provenance": "heuristic",
      "why": {
        "lexical": 0.194,
        "structural": 0.7,
        "matched": [
