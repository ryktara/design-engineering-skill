  "core": [
    {
      "id": "comp-checkout-one-page",
      "kind": "component",
      "category": "form",
      "title": "One-page checkout",
      "facets": [
        "component",
        "platform"
      ],
      "concerns": [
        "component",
        "feedback",
        "states",
        "structure"
      ],
      "concepts": [
        "feedback.validation_errors",
        "touch.ime_keyboard",
        "feedback.confirmation_destructive",
        "state.saving_conflict",
        "layout.one_primary_action",
        "feedback.trust_signals"
      ],
      "covers": [
        "inline validation messages and error recovery",
        "on-screen keyboard (IME) aware layout",
        "confirmation of destructive or high-risk actions",
        "saving, saved and conflict states",
        "one primary action per view",
        "trust and cost transparency before commitment"
      ],
      "score": 0.351,
      "guidance": "Order summary is visible on desktop (side column) and collapsible-but-present at the top on phones with the total always shown; guest checkout first, account optional; sections in the order contact → shipping → payment → review, each with a visible heading and inline validation on blur plus a focused error summary on submit; address fields use autocomplete attributes and correct input types/IME; the pay button states the amount, is disabled only while processing (with a visible status), and is protected against double submission; trust and cost information (shipping, tax) appears before payment, never as a surprise; progress is saved locally so a reload does not lose entries.",
      "use_when": "Purchase flows with contact, shipping, payment and review on one scrolling page.",
      "avoid_when": "Multi-session or regulated flows that need a stepper with server-side validation per step.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "heuristic",
      "implementation": {
        "html-css": "autocomplete=\"shipping postal-code\" etc.; inputmode=\"numeric\" for card and postal fields; aria-describedby error links; aria-live status on the pay button."
      },
      "incompatible": [
        "nav-wizard"
      ],
      "why": {
        "lexical": 0.0,
        "structural": 0.78,
        "matched": [
          "platform web",
          "mode audit",
          "product ecommerce",
          "screen checkout"
        ]
      },
      "role": "core",
      "selected_for": "critical concept (SPECIFIC): trust and cost transparency before commitment, one primary action per view"
    },
