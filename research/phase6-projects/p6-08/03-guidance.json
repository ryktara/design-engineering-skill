    },
    {
      "id": "grid-single-tab-stop",
      "kind": "rule",
      "category": "table",
      "title": "Grids with row actions are one Tab stop",
      "facets": [
        "component",
        "platform"
      ],
      "concerns": [
        "accessibility",
        "data-display",
        "interaction"
      ],
      "concepts": [
        "interaction.keyboard_navigation",
        "interaction.focus_visible",
        "table.selection_bulk",
        "interaction.selection_visible"
      ],
      "covers": [
        "keyboard navigation and focus order",
        "visible focus",
        "selection state and bulk actions",
        "selected state visible and distinct from focus and hover"
      ],
      "score": 0.542,
      "guidance": "Tab enters the grid once and leaves it once; arrow keys move between cells/rows (roving tabindex or a focus manager), Enter/Space activates the focused cell's action, Escape returns from an edited cell to navigation mode; row actions become reachable when the row or actions cell is focused and are also available from a row context/actions menu; a table with 24 rows must never produce 24 Tab stops per action column. Announce the current row/column (aria-rowindex/colindex or the platform's automation properties) and keep a visible focus indicator on the active cell.",
      "use_when": "Data tables or grids where each row has buttons/links (edit, delete, approve, download) and there are more than a handful of rows.",
      "avoid_when": "Small static tables with no interactive cells.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "accessibility-requirement",
      "why": {
        "lexical": 0.396,
        "structural": 0.72,
        "matched": [
          "platform web",
          "input keyboard,pointer",
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "required coverage (SPECIFIC): visible focus, keyboard navigation and focus order, accessibility, interaction"
    },
    {
      "id": "layout-states-empty-loading-error",
      "kind": "rule",
      "category": "feedback",
      "title": "Design empty, loading, error, and partial states",
      "facets": [
        "component"
      ],
      "concerns": [
        "states"
      ],
      "concepts": [
        "state.loading_empty_error"
      ],
      "covers": [
        "loading, empty and error states"
      ],
      "score": 0.275,
      "guidance": "Empty: what this is, why it is empty, one action. Loading: skeleton with final dimensions, then content; announce completion. Error: what failed, what to do, retry that works; keep entered data. Partial: show what loaded, mark what didn't. On TV, focus must land somewhere valid in each state.",
      "use_when": "Every list, table, chart, form, and detail screen.",
      "avoid_when": "Never ship a blank area for empty data; never show a spinner for more than ~1 s without a skeleton or progress; never show an error without a next step.",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "heuristic",
      "why": {
        "lexical": 0.058,
        "structural": 0.54,
        "matched": [
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "required coverage (GENERIC): loading, empty and error states"
    }
