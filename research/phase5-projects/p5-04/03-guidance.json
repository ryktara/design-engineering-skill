  "core": [
    {
      "id": "comp-product-detail-page",
      "kind": "component",
      "category": "detail",
      "title": "Product detail page (PDP)",
      "facets": [
        "component",
        "platform"
      ],
      "concerns": [
        "component",
        "content",
        "feedback",
        "structure"
      ],
      "concepts": [
        "layout.one_primary_action",
        "perf.layout_shift",
        "a11y.accessible_names",
        "touch.minimum_target",
        "feedback.trust_signals"
      ],
      "covers": [
        "one primary action per view",
        "no layout shift",
        "accessible names and labels",
        "large touch targets (≥44–48 px)",
        "trust and cost transparency before commitment"
      ],
      "score": 0.699,
      "guidance": "Above the fold on every viewport: product name, price (with tabular figures and any discount stated in words), primary image, variant selectors and one add-to-cart action; variant choice is a radio group with visible labels and a disabled-but-visible state for out-of-stock options; the add-to-cart button is sticky on phones without covering focused controls; shipping, returns and stock are stated next to the price, not in a tab; the gallery has fixed aspect boxes (no layout shift), keyboard-operable thumbnails and alt text per image; reviews show the distribution and a count, and stars always have a text value; secondary actions (wishlist, share, size guide) never compete visually with add-to-cart; the size guide opens as a dialog that returns focus.",
      "use_when": "Selling a physical or digital product: gallery, variants, price, availability, add-to-cart, trust and shipping information, reviews.",
      "avoid_when": "Catalog/listing pages (use list + filters) or marketing landing pages (hero + narrative).",
      "risk": {
        "a11y": "medium",
        "perf": "medium"
      },
      "provenance": "heuristic",
      "implementation": {
        "html-css": "<fieldset> variants; <output aria-live=\"polite\"> for price/availability updates; position: sticky bar with scroll-padding-bottom so focused fields stay visible."
      },
      "why": {
        "lexical": 0.632,
        "structural": 0.78,
        "matched": [
          "platform web",
          "mode audit",
          "product ecommerce",
          "screen detail"
        ]
      },
      "role": "core",
      "selected_for": "highest-scoring component with lexical evidence"
    },
    {
      "id": "imagery-thumbnails",
      "kind": "pattern",
      "category": "imagery",
      "title": "Functional thumbnails",
      "facets": [
        "visual"
      ],
      "concerns": [
        "brand",
        "content"
      ],
      "concepts": [],
      "covers": [],
      "score": 0.413,
      "guidance": "Fixed size per context, consistent crop (object-fit cover with a focal point), alt text that is empty when redundant with the adjacent text, lazy-loaded below the fold with intrinsic size set.",
      "use_when": "Lists and grids where a small image helps recognition (products, people, files) but text carries the meaning.",
      "avoid_when": "When the thumbnail would be a generic placeholder for most items.",
      "risk": {
        "a11y": "low",
        "perf": "medium"
      },
      "provenance": "heuristic",
      "incompatible": [
        "imagery-immersive-backdrop",
        "surface-imagery-backed"
      ],
      "why": {
        "lexical": 0.251,
