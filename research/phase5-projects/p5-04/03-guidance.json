  "guardrails": [
    {
      "id": "a11y-keyboard-operable",
      "kind": "rule",
      "category": "accessibility",
      "title": "Everything operable by keyboard, no traps",
      "facets": [
        "accessibility",
        "platform"
      ],
      "concerns": [
        "accessibility",
        "interaction"
      ],
      "concepts": [
        "interaction.keyboard_navigation",
        "interaction.hover_independence"
      ],
      "covers": [
        "keyboard navigation and focus order",
        "no hover dependence"
      ],
      "score": 0.356,
      "guidance": "Tab reaches every control in visual order; composite widgets use arrow keys with a roving tabindex so Tab is not consumed by every cell; Escape closes layers and returns focus to the invoker; nothing traps focus except a modal, and the modal itself must be escapable. Provide a keyboard alternative for every drag interaction.",
      "use_when": "Every interactive element, including custom widgets, drag/drop, sliders, menus, date pickers, and anything that appears on hover.",
      "avoid_when": "Never skip.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "accessibility-requirement",
      "why": {
        "lexical": 0.025,
        "structural": 0.76,
        "matched": [
          "platform web",
          "input keyboard",
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "required coverage: accessibility, interaction, no hover dependence, keyboard navigation and focus order"
    },
    {
      "id": "a11y-focus-visible",
      "kind": "rule",
      "category": "focus",
      "title": "Focus visible and not obscured",
      "facets": [
        "interaction",
        "platform"
      ],
      "concerns": [
        "accessibility",
        "interaction"
      ],
      "concepts": [
        "interaction.focus_visible"
      ],
      "covers": [
        "visible focus"
      ],
      "score": 0.376,
      "guidance": "Focus indicator ≥2 px with ≥3:1 contrast against adjacent colours and against the unfocused state; sticky UI gets scroll-padding so a focused control scrolls into clear view. On TV the indicator must be obvious at 3 m (scale + border/glow).",
      "use_when": "Every focusable element in every theme; sticky headers, footers, toasts, and cookie banners must never cover the focused element.",
      "avoid_when": "Never remove focus styles; use :focus-visible to hide them for mouse clicks only.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "accessibility-requirement",
      "why": {
        "lexical": 0.062,
        "structural": 0.76,
        "matched": [
          "platform web",
          "input keyboard",
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "required coverage: visible focus"
    },
    {
      "id": "layout-states-empty-loading-error",
      "kind": "rule",
      "category": "feedback",
      "title": "Design empty, loading, error, and partial states",
      "facets": [
        "component"
      ],
      "concerns": [
        "states"
      ],
      "concepts": [
        "state.loading_empty_error"
      ],
      "covers": [
        "loading, empty and error states"
      ],
      "score": 0.261,
      "guidance": "Empty: what this is, why it is empty, one action. Loading: skeleton with final dimensions, then content; announce completion. Error: what failed, what to do, retry that works; keep entered data. Partial: show what loaded, mark what didn't. On TV, focus must land somewhere valid in each state.",
      "use_when": "Every list, table, chart, form, and detail screen.",
      "avoid_when": "Never ship a blank area for empty data; never show a spinner for more than ~1 s without a skeleton or progress; never show an error without a next step.",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "heuristic",
      "why": {
        "lexical": 0.0,
        "structural": 0.58,
        "matched": [
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "required coverage: loading, empty and error states"
    },
    {
      "id": "web-responsive-breakpoints",
      "kind": "rule",
      "category": "responsive",
      "title": "Web: content-driven breakpoints and a test matrix",
      "facets": [
        "layout",
        "platform"
      ],
      "concerns": [
        "adaptive"
      ],
      "concepts": [
        "adaptive.breakpoint_matrix",
        "adaptive.navigation_transform"
      ],
      "covers": [
        "breakpoint matrix",
        "navigation transforms across widths"
      ],
      "score": 0.315,
      "guidance": "Use the project's breakpoints; test at least: narrowest supported (320–360), common phone (390), tablet (768–834), laptop (1280–1366), desktop (1536–1920), plus 200% zoom. Check clipping, overflow, wrapping, tap targets, hierarchy order, and that navigation and dialogs transform (drawer ↔ rail, sheet ↔ dialog). Prefer container queries for components.",
      "use_when": "Every responsive layout, navigation transformation, table/grid behaviour, modal/drawer switching.",
      "avoid_when": "Never test a single viewport; never invent breakpoints when the framework/codebase defines them (Tailwind screens, MUI breakpoints, project tokens).",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "engineering-practice",
      "why": {
        "lexical": 0.0,
        "structural": 0.7,
        "matched": [
          "platform web",
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "recommended coverage: adaptive, breakpoint matrix"
    }
