    {
      "id": "tv-dpad-hold-pacing",
      "kind": "rule",
      "category": "focus",
      "title": "TV: pace held D-pad repeats on rails and grids",
      "facets": [
        "interaction",
        "platform"
      ],
      "concerns": [
        "accessibility",
        "interaction"
      ],
      "concepts": [
        "perf.focus_latency",
