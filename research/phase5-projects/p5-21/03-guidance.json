    {
      "id": "comp-product-detail-page",
      "kind": "component",
      "category": "detail",
      "title": "Product detail page (PDP)",
      "facets": [
        "component",
        "platform"
      ],
      "concerns": [
        "component",
        "content",
        "feedback",
