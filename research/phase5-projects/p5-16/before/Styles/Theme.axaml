<!--
  FleetDesk theme (light-first).

  Design language in one breath:
    - one accent colour (blue) on a neutral grey/white palette
    - Segoe UI, falling back to the bundled Inter face
    - 4px corner radius everywhere
    - 8px spacing scale (8 / 16 / 24 / 32)
    - flat surfaces: white panel, 1px line border, NO drop shadows
  Views must reference these resources instead of literal colours / sizes.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- ===== Palette (colours) ===== -->
      <Color x:Key="CanvasColor">#F5F6F8</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="SurfaceAltColor">#F0F2F5</Color>
      <Color x:Key="LineColor">#D9DDE3</Color>
      <Color x:Key="TextPrimaryColor">#1F2933</Color>
      <Color x:Key="TextMutedColor">#5F6B7A</Color>
      <Color x:Key="AccentColor">#2563EB</Color>
      <Color x:Key="AccentHoverColor">#1D4ED8</Color>
      <Color x:Key="AccentSoftColor">#E8EFFD</Color>
      <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
      <Color x:Key="SuccessColor">#15803D</Color>
      <Color x:Key="SuccessSoftColor">#E6F4EA</Color>
      <Color x:Key="WarningColor">#B45309</Color>
      <Color x:Key="WarningSoftColor">#FDF1E1</Color>
      <Color x:Key="DangerColor">#B91C1C</Color>
      <Color x:Key="DangerSoftColor">#FCE8E8</Color>

      <!-- ===== Palette (brushes) ===== -->
      <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
      <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
      <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
      <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

      <!-- ===== Typography ===== -->
      <FontFamily x:Key="AppFontFamily">Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
      <x:Double x:Key="FontSizeBody">13</x:Double>
      <x:Double x:Key="FontSizeSmall">12</x:Double>
      <x:Double x:Key="FontSizeTitle">20</x:Double>
      <x:Double x:Key="FontSizeSection">15</x:Double>

      <!-- ===== Shape ===== -->
      <CornerRadius x:Key="AppCornerRadius">4</CornerRadius>
      <Thickness x:Key="AppBorderThickness">1</Thickness>
      <Thickness x:Key="AppBorderBottom">0,0,0,1</Thickness>
      <Thickness x:Key="AppBorderTop">0,1,0,0</Thickness>

      <!-- ===== Spacing scale (base 8) ===== -->
      <x:Double x:Key="Space1">8</x:Double>
      <x:Double x:Key="Space2">16</x:Double>
      <x:Double x:Key="Space3">24</x:Double>
      <x:Double x:Key="Space4">32</x:Double>
      <Thickness x:Key="Pad1">8</Thickness>
      <Thickness x:Key="Pad2">16</Thickness>
      <Thickness x:Key="Pad3">24</Thickness>
      <Thickness x:Key="PadButton">12,6</Thickness>
      <Thickness x:Key="PadInput">8,6</Thickness>
      <Thickness x:Key="PadBar">8,4</Thickness>
      <Thickness x:Key="MarginBelow1">0,0,0,8</Thickness>
      <Thickness x:Key="MarginBelow2">0,0,0,16</Thickness>
      <Thickness x:Key="MarginAbove1">0,8,0,0</Thickness>
      <Thickness x:Key="MarginRight1">0,0,8,0</Thickness>

      <!-- ===== Fluent overrides so built-in control templates follow the language ===== -->
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      <Color x:Key="SystemAccentColor">#2563EB</Color>
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===== Base ===== -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- ===== Text roles ===== -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="Margin" Value="{StaticResource MarginBelow1}" />
  </Style>

  <!-- ===== Surfaces: flat, 1px border, radius 4, no shadow ===== -->
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource AppBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource Pad2}" />
  </Style>
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Padding" Value="{StaticResource PadBar}" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource AppBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource PadButton}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource AppBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource PadInput}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource AppBorderThickness}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource AppBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource PadInput}" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <!-- ===== Menu bar ===== -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- ===== Lists ===== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="{StaticResource PadInput}" />
    <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>

  <!-- ===== DataGrid ===== -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource AppBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="RowHeight" Value="36" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="{StaticResource PadInput}" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="{StaticResource PadInput}" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ===== Status badge (Border.badge + a status class) ===== -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
    <Setter Property="BorderThickness" Value="{StaticResource AppBorderThickness}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.badge.high">
    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
  </Style>
  <Style Selector="Border.badge.high > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>
  <Style Selector="Border.badge.normal">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.badge.normal > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

</Styles>
