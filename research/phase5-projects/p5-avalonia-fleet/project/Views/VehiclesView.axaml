<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FleetDesk.ViewModels"
             x:Class="FleetDesk.Views.VehiclesView">

  <Design.DataContext>
    <vm:VehiclesViewModel />
  </Design.DataContext>

  <!--
    Width adaptation (see VehiclesView.axaml.cs for the thresholds).

      >= 1120 epx  wide     header on one row, all seven columns
      <  1120 epx  narrow   filter row drops under the title and fills the width;
                            the "Odometer (km)" column is dropped
      <  1000 epx  compact  additionally the "Last service" column is dropped

    Columns are dropped in documented priority order (lowest first: Odometer,
    Last service). Nothing is lost: both values stay in the selection summary at
    the bottom of the view.
  -->
  <UserControl.Styles>
    <!-- narrow: the filter cluster moves to its own full-width row under the title -->
    <Style Selector="UserControl.narrow Grid#FilterPanel">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="{StaticResource MarginAbove1}" />
    </Style>
    <!-- narrow: the filter box stops being a fixed 280 and takes the remaining width -->
    <Style Selector="UserControl.narrow TextBox#FilterBox">
      <Setter Property="Width" Value="NaN" />
    </Style>
  </UserControl.Styles>

  <DockPanel LastChildFill="True">

    <!-- Header row: title + filter -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
          Margin="{StaticResource MarginBelow2}">
      <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" VerticalAlignment="Center">
        <TextBlock Classes="title" Text="Vehicles" />
        <TextBlock Classes="muted" TextWrapping="Wrap">
          <Run Text="{Binding ShownCount}" />
          <Run Text="of" />
          <Run Text="{Binding TotalCount}" />
          <Run Text="vehicles shown -" />
          <Run Text="{Binding ServiceSummary}" />
        </TextBlock>
      </StackPanel>
      <Grid x:Name="FilterPanel" Grid.Column="1" Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"
            HorizontalAlignment="Right">
        <CheckBox Grid.Column="0" Content="Overdue for service only"
                  IsChecked="{Binding OverdueOnly, Mode=TwoWay}"
                  VerticalAlignment="Center"
                  Margin="{StaticResource MarginRight1}" />
        <TextBox x:Name="FilterBox" Grid.Column="1" Width="280" MinWidth="200"
                 Watermark="Filter by id, plate, driver, status or service"
                 Text="{Binding FilterText, Mode=TwoWay}"
                 Margin="{StaticResource MarginRight1}" />
        <Button Grid.Column="2" Content="Clear" Command="{Binding ClearFilterCommand}" />
      </Grid>
    </Grid>

    <!-- Selection summary -->
    <Border DockPanel.Dock="Bottom" Classes="surface" Padding="{StaticResource PadInput}" Margin="{StaticResource MarginAbove1}">
      <TextBlock Classes="muted" Text="{Binding SelectionSummary}" TextWrapping="Wrap" />
    </Border>

    <!-- Grid -->
    <DataGrid x:Name="VehicleGrid" ItemsSource="{Binding FilteredVehicles}"
              SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              SelectionMode="Single"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" />
        <DataGridTextColumn Header="Plate" Binding="{Binding Plate}" Width="110" />
        <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="*" MinWidth="140" />
        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="140" />
        <DataGridTextColumn Header="Odometer (km)" Binding="{Binding OdometerKm, StringFormat={}{0:N0}}" Width="140" />
        <DataGridTextColumn Header="Last service" Binding="{Binding LastService, StringFormat={}{0:yyyy-MM-dd}}" Width="130" />
        <!-- Service status: words + colour (never colour alone); sortable by days past due -->
        <DataGridTemplateColumn Header="Service" Width="140" SortMemberPath="DaysPastDue">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Panel VerticalAlignment="Center">
                <Border Classes="badge"
                        Classes.danger="{Binding IsServiceOverdue}"
                        Classes.warning="{Binding IsServiceDueSoon}"
                        IsVisible="{Binding NeedsServiceAttention}"
                        HorizontalAlignment="Left">
                  <TextBlock Text="{Binding ServiceLabel}" />
                </Border>
                <TextBlock Classes="muted" Text="{Binding ServiceLabel}"
                           IsVisible="{Binding !NeedsServiceAttention}"
                           VerticalAlignment="Center" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
