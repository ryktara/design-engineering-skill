      "id": "web-responsive-breakpoints",
      "kind": "rule",
      "category": "responsive",
      "title": "Web: content-driven breakpoints and a test matrix",
      "facets": [
        "layout",
        "platform"
      ],
      "concerns": [
        "adaptive"
      ],
      "concepts": [
        "adaptive.breakpoint_matrix",
        "adaptive.navigation_transform"
      ],
      "covers": [
        "breakpoint matrix",
        "navigation transforms across widths"
      ],
      "score": 0.297,
      "guidance": "Use the project's breakpoints; test at least: narrowest supported (320–360), common phone (390), tablet (768–834), laptop (1280–1366), desktop (1536–1920), plus 200% zoom. Check clipping, overflow, wrapping, tap targets, hierarchy order, and that navigation and dialogs transform (drawer ↔ rail, sheet ↔ dialog). Prefer container queries for components.",
      "use_when": "Every responsive layout, navigation transformation, table/grid behaviour, modal/drawer switching.",
      "avoid_when": "Never test a single viewport; never invent breakpoints when the framework/codebase defines them (Tailwind screens, MUI breakpoints, project tokens).",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
