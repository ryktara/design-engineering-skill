  "core": [
    {
      "id": "nav-wizard",
      "kind": "pattern",
      "category": "navigation",
      "title": "Linear wizard / stepper",
      "facets": [
        "navigation"
      ],
      "concerns": [
        "navigation"
      ],
      "concepts": [
        "feedback.progress_indicator",
        "onboarding.linear_wizard"
      ],
      "covers": [
        "progress indicator",
        "linear multi-step wizard"
      ],
      "score": 0.348,
      "guidance": "Show step count and current step, allow going back without data loss, put one primary action per step, validate per step not at the end, and let completed steps be revisited. Save progress for flows longer than ~3 minutes. On TV, each step is a full screen with a single focused default action.",
      "use_when": "One task with ordered dependent steps (checkout, onboarding, application forms) where finishing matters more than exploring.",
      "avoid_when": "Steps are independent and users need to jump around (use tabs or a form with sections), or the whole thing fits on one screen.",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "heuristic",
      "incompatible": [
        "nav-left-rail",
        "nav-tv-side"
      ],
      "why": {
        "lexical": 0.22,
        "structural": 0.46,
        "matched": [
          "secondary mode",
          "product government,healthcare"
        ]
      },
      "role": "core",
      "selected_for": "highest-scoring pattern with lexical evidence"
    },
    {
      "id": "surface-flat-tonal",
      "kind": "pattern",
      "category": "surface",
      "title": "Flat surfaces with tonal layers",
      "facets": [
        "layout"
      ],
      "concerns": [
        "brand",
        "structure"
      ],
      "concepts": [],
      "covers": [],
      "score": 0.325,
      "guidance": "Define three tonal steps per theme with measured contrast (each step ≥1.1:1 apart and borders ≥3:1 where they mark boundaries). Shadows reserved for transient layers (menus, dialogs, drag). Reads professional at any density and avoids the 'everything is a floating card' look.",
      "use_when": "Most application UI: hierarchy expressed with subtle background tone steps (canvas → surface → elevated) and dividers rather than shadows on everything.",
      "avoid_when": "When physical elevation carries meaning (floating menus, dragged items) it still needs a shadow; don't flatten those.",
      "risk": {
        "a11y": "low",
        "perf": "low"
      },
      "provenance": "heuristic",
      "incompatible": [
        "surface-glass",
        "surface-elevated-cards"
      ],
      "why": {
        "lexical": 0.183,
        "structural": 0.32,
        "matched": [
          "secondary mode"
        ]
      },
      "role": "core",
      "selected_for": "highest-scoring pattern with lexical evidence"
    }
  ],
  "guardrails": [
    {
      "id": "states-persistence-and-session",
      "kind": "rule",
      "category": "states",
      "title": "Saving, saved, autosave, session expiry, and permission-denied states",
      "facets": [
        "component",
        "platform"
      ],
      "concerns": [
        "feedback",
        "states"
      ],
      "concepts": [
        "state.saving_conflict",
        "state.session_expiry",
        "feedback.confirmation_destructive"
      ],
      "covers": [
        "saving, saved and conflict states",
        "session expiry and idle reset",
        "confirmation of destructive or high-risk actions"
      ],
      "score": 0.571,
      "guidance": "Show saving → saved as a quiet inline status with a timestamp (not a toast per keystroke); autosave drafts and say so; warn before a session expires with a way to extend, and never discard entered data on expiry on a personal device (restore the draft after re-authentication; on shared or public screens clear it instead); permission-denied is a designed state that explains what is missing and who can grant it rather than an empty screen; destructive or irreversible saves confirm once with the safe action as default.",
      "use_when": "Forms and editors longer than a minute, multi-step flows, authenticated sessions with timeouts, screens whose data depends on permissions.",
      "avoid_when": "Public kiosks and shared screens: there the session is cleared on idle and nothing is restored (see shared-device-privacy).",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "heuristic",
      "why": {
        "lexical": 0.498,
        "structural": 0.66,
        "matched": [
          "platform web",
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "most relevant record for the request wording"
    },
    {
      "id": "a11y-keyboard-operable",
      "kind": "rule",
      "category": "accessibility",
      "title": "Everything operable by keyboard, no traps",
      "facets": [
        "accessibility",
        "platform"
      ],
      "concerns": [
        "accessibility",
        "interaction"
      ],
      "concepts": [
        "interaction.keyboard_navigation",
        "interaction.hover_independence"
      ],
      "covers": [
        "keyboard navigation and focus order",
        "no hover dependence"
      ],
      "score": 0.324,
      "guidance": "Tab reaches every control in visual order; composite widgets use arrow keys with a roving tabindex so Tab is not consumed by every cell; Escape closes layers and returns focus to the invoker; nothing traps focus except a modal, and the modal itself must be escapable. Provide a keyboard alternative for every drag interaction.",
      "use_when": "Every interactive element, including custom widgets, drag/drop, sliders, menus, date pickers, and anything that appears on hover.",
      "avoid_when": "Never skip.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "accessibility-requirement",
      "why": {
        "lexical": 0.0,
        "structural": 0.72,
        "matched": [
          "platform web",
          "input keyboard",
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "required coverage: accessibility, interaction, no hover dependence, keyboard navigation and focus order"
    },
    {
      "id": "a11y-focus-visible",
      "kind": "rule",
      "category": "focus",
      "title": "Focus visible and not obscured",
      "facets": [
        "interaction",
        "platform"
      ],
      "concerns": [
        "accessibility",
        "interaction"
      ],
      "concepts": [
        "interaction.focus_visible"
      ],
      "covers": [
        "visible focus"
      ],
      "score": 0.324,
      "guidance": "Focus indicator ≥2 px with ≥3:1 contrast against adjacent colours and against the unfocused state; sticky UI gets scroll-padding so a focused control scrolls into clear view. On TV the indicator must be obvious at 3 m (scale + border/glow).",
      "use_when": "Every focusable element in every theme; sticky headers, footers, toasts, and cookie banners must never cover the focused element.",
      "avoid_when": "Never remove focus styles; use :focus-visible to hide them for mouse clicks only.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "accessibility-requirement",
      "why": {
        "lexical": 0.0,
