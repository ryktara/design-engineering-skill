  "guardrails": [
    {
      "id": "table-column-disambiguation",
      "kind": "rule",
      "category": "table",
      "title": "Editable grids: make the current column and its unit unmistakable",
      "facets": [
        "component",
        "platform"
      ],
      "concerns": [
        "data-display"
      ],
      "concepts": [
        "table.tabular_figures",
        "table.inline_edit",
        "feedback.validation_errors"
      ],
      "covers": [
        "tabular figures and numeric alignment",
        "inline editing",
        "inline validation messages and error recovery"
      ],
      "score": 0.784,
      "guidance": "Mark the active column in the header (bar + strong text); show the unit as an affix inside the editor (EA suffix for quantities, currency prefix for money); use role-distinct formats (integers for counts, fixed decimals for money, unit in the header); bracket money columns with a stronger divider; validate implausible values (a price typed as a quantity) inline before commit.",
      "use_when": "Data-entry grids where adjacent numeric columns hold different roles (quantity vs price, hours vs rate) and operators type into the wrong one.",
      "avoid_when": "Never format a count like money; never rely on header text alone; never leave the active column unmarked while typing.",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "heuristic",
      "why": {
        "lexical": 0.837,
        "structural": 0.72,
        "matched": [
          "platform desktop",
          "input keyboard,pointer",
          "mode audit",
          "product erp"
        ]
