      ],
      "covers": [
        "inline validation messages and error recovery",
        "live region status announcements",
        "high contrast",
        "keyboard shortcuts / accelerators",
        "persisted workspace and selection"
      ],
      "score": 0.343,
      "guidance": "One status bar at the bottom of the window with fixed regions (selection summary, sync/save state with timestamp, error count as a link, active filter) separated by real separators, not spaces; validation for the current row/cell is echoed there in words ('Line 50: Quantity must be greater than 0') and the error count opens a list; F8 / Shift+F8 (or the project's convention) walk to the next and previous error and move focus into the cell; error styling never paints over the value text (tint the cell background and keep ≥ 4.5:1 for the text); announce status changes with LiveSetting/UIA so screen readers hear them; the bar keeps its height at every window width.",
      "use_when": "Data-entry and workbench windows where validation, selection and sync state must be visible without dialogs or toasts.",
      "avoid_when": "Consumer apps without a persistent window chrome; mobile.",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "platform-standard",
      "implementation": {
        "wpf": "StatusBar with StatusBarItem regions and Separator; Validation.ErrorTemplate sets a Border behind the AdornedElementPlaceholder, not over it; RoutedUICommand for NextError (F8)."
      },
      "why": {
