      "id": "desktop-status-bar-and-error-navigation",
      "kind": "rule",
      "category": "feedback",
      "title": "Desktop status bar as the persistent feedback surface, with next-error navigation",
      "facets": [
        "component",
        "platform"
      ],
      "concerns": [
        "accessibility",
