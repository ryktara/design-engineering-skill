      "score": 0.372,
      "guidance": "Patient banner always visible (identity, allergies, alerts) as the focal element, master-detail for patient lists and records, strict status colour language with text and icons (never colour alone), large legible numerics with units, quiet neutral surfaces, confirmation for critical actions with the safe default, interruption-safe autosave. Identity via the banner treatment and status language; restraint is the brand.",
      "use_when": "EHR/EMR, lab, pharmacy, ward tools for clinicians under time pressure and interruption.",
      "avoid_when": "Patient-facing apps (use 'Service app').",
      "risk": {
        "a11y": "high",
        "perf": "medium"
      },
      "provenance": "internal-preference",
      "incompatible": [
        "surface-glass",
        "imagery-hero",
