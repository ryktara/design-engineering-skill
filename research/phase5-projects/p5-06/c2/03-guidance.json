    },
    {
      "id": "data-exceptions-first",
      "kind": "rule",
      "category": "feedback",
      "title": "Exceptions first: surface what needs attention in lists and tables",
      "facets": [
        "component"
      ],
      "concerns": [
        "accessibility",
        "data-display",
        "feedback"
      ],
      "concepts": [
        "data.exception_first",
        "a11y.color_not_only",
        "env.glanceable_status",
        "table.tabular_figures"
      ],
      "covers": [
        "exceptions and anomalies first",
        "no colour alone for status",
        "glanceable status",
        "tabular figures and numeric alignment"
      ],
      "score": 0.304,
      "guidance": "Compute the status in the model and show it as a column or badge with a word plus icon plus colour; sort or group exceptions first (or offer a one-tap 'only overdue' filter); show a count in the header/status bar; keep the row otherwise unchanged so scanning stays fast; state the rule that makes an item an exception (e.g. '> 90 days since service').",
      "use_when": "Any collection where some items need action (overdue, late, failed, expiring, over budget) and the user should see them without opening each one.",
      "avoid_when": "Never rely on colour alone for the status; never bury the exception state inside the detail view; never sort exceptions below normal rows by default.",
      "risk": {
        "a11y": "medium",
        "perf": "low"
      },
      "provenance": "heuristic",
      "why": {
        "lexical": 0.111,
        "structural": 0.54,
        "matched": [
          "mode audit"
        ]
      },
      "role": "guardrail",
      "selected_for": "required coverage: no colour alone for status, glanceable status"
    },
    {
      "id": "a11y-skip-link",
      "kind": "rule",
      "category": "accessibility",
      "title": "Bypass blocks: skip links and landmark shortcuts",
      "facets": [
        "accessibility",
        "platform"
      ],
      "concerns": [
        "accessibility"
      ],
      "concepts": [
        "interaction.keyboard_navigation",
        "a11y.semantics",
        "interaction.focus_visible"
      ],
      "covers": [
        "keyboard navigation and focus order",
        "semantic structure and roles",
        "visible focus"
      ],
      "score": 0.324,
      "guidance": "Provide a 'Skip to <region>' link as the first focusable element (visible on focus), targets with tabindex=-1 and a heading; expose landmarks (main, nav, region with aria-label) so screen-reader users can jump; keep the number of tab stops before the first control small (≤ 5) and give composite widgets a single tab stop.",
      "use_when": "Any page where the keyboard user must tab through navigation, headers or a chart before reaching controls such as filters, forms or the main content.",
      "avoid_when": "Never make the skip link the only visible-on-focus element without a focus ring; never point it at an element that cannot receive focus.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "accessibility-requirement",
      "why": {
