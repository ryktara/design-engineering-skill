      "covers": [
        "keyboard navigation and focus order",
        "semantic structure and roles",
        "visible focus"
      ],
      "score": 0.324,
      "guidance": "Provide a 'Skip to <region>' link as the first focusable element (visible on focus), targets with tabindex=-1 and a heading; expose landmarks (main, nav, region with aria-label) so screen-reader users can jump; keep the number of tab stops before the first control small (≤ 5) and give composite widgets a single tab stop.",
      "use_when": "Any page where the keyboard user must tab through navigation, headers or a chart before reaching controls such as filters, forms or the main content.",
      "avoid_when": "Never make the skip link the only visible-on-focus element without a focus ring; never point it at an element that cannot receive focus.",
      "risk": {
        "a11y": "high",
        "perf": "low"
      },
      "provenance": "accessibility-requirement",
      "why": {
