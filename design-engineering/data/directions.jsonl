{"id": "dir-industrial-hmi", "kind": "direction", "title": "Industrial HMI / control panel", "category": "direction", "intent": ["create", "design-system", "refactor"], "platform": ["desktop", "kiosk", "tablet"], "input": ["touch", "pointer"], "product_fit": ["iot"], "density": "high", "risk": {"a11y": "high", "perf": "medium"}, "use_when": "Machine control, SCADA, building management, device dashboards viewed at arm's length on the floor.", "avoid_when": "Consumer smart-home apps (use 'Service app' or 'Feed').", "compatible": ["nav-top-bar", "layout-dashboard-grid", "density-high", "surface-flat-tonal", "card-bordered", "typography-neutral-sans", "color-neutral-accent", "motion-functional-minimal", "focus-ring-standard", "cta-toolbar-commands", "imagery-data-graphics", "icon-filled-system", "metadata-rich", "chart-realtime", "chart-progress-gauge"], "incompatible": ["surface-glass", "motion-cinematic", "imagery-hero", "color-dominant-brand"], "guidance": "Grey-scale by default so alarms are the only saturated colour (ISA-101 high-performance HMI), large touch targets with gloves in mind, state shown by shape + text + colour, trend sparklines with thresholds, confirm-and-hold for hazardous commands, no decorative anything. Identity via the schematic style and status semantics.", "fingerprint": {"navigation_model": "top-bar", "layout_topology": "dashboard-grid", "content_density": "high", "grid_behavior": "fixed", "card_geometry": "bordered", "corner_language": "sharp", "typography_character": "neutral-sans", "color_strategy": "neutral-plus-accent", "surface_strategy": "bordered", "image_strategy": "data-graphics", "icon_strategy": "filled", "motion_character": "functional-minimal", "focus_strategy": "ring", "metadata_density": "rich", "cta_strategy": "toolbar-commands"}, "provenance": "platform-standard", "source": "ISA-101 high-performance HMI principles", "version": "1.0", "keywords": ["hmi", "scada", "industrial", "control panel", "alarms"]}
